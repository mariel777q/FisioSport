@model FISIOSPORT.Models.CrearCitaViewModel
@{
    ViewData["Title"] = "Nueva cita";
}

<a asp-controller="Fisioterapeuta" asp-action="Dashboard" class="text-sm text-gray-400 hover:text-cyan-400 transition inline-block mb-6">&larr; Volver al dashboard</a>

<div class="max-w-lg rounded-xl border border-gray-800 bg-[#161b22] p-6">
    <h3 class="text-xl font-bold text-white mb-5">Registrar nueva cita</h3>

    <form asp-controller="Fisioterapeuta" asp-action="CrearCita" method="post" class="space-y-5">
        <div>
            <label asp-for="PacienteId" class="block text-sm text-gray-300 mb-1">Paciente</label>
            <select asp-for="PacienteId" class="w-full bg-[#0d1117] border border-gray-700 rounded-lg px-4 py-2.5 text-gray-100 focus:outline-none focus:ring-2 focus:ring-cyan-400/60">
                <option value="">-- Selecciona un paciente --</option>
                @foreach (var p in Model.PacientesDisponibles)
                {
                    <option value="@p.Id">@p.Nombre</option>
                }
            </select>
            <span asp-validation-for="PacienteId" class="text-red-400 text-xs"></span>
        </div>

        <div>
            <label asp-for="Fecha" class="block text-sm text-gray-300 mb-1"></label>
            <input asp-for="Fecha" type="date" class="w-full bg-[#0d1117] border border-gray-700 rounded-lg px-4 py-2.5 text-gray-100 focus:outline-none focus:ring-2 focus:ring-cyan-400/60" />
        </div>

        <div>
            <label asp-for="Hora" class="block text-sm text-gray-300 mb-1"></label>
            <input asp-for="Hora" type="time" class="w-full bg-[#0d1117] border border-gray-700 rounded-lg px-4 py-2.5 text-gray-100 focus:outline-none focus:ring-2 focus:ring-cyan-400/60" />
            <span asp-validation-for="Hora" class="text-red-400 text-xs"></span>
        </div>

        <div>
            <label asp-for="Notas" class="block text-sm text-gray-300 mb-1"></label>
            <textarea asp-for="Notas" rows="3" class="w-full bg-[#0d1117] border border-gray-700 rounded-lg px-4 py-2.5 text-gray-100 focus:outline-none focus:ring-2 focus:ring-cyan-400/60"></textarea>
        </div>

        <button type="submit" class="w-full bg-cyan-400 text-[#0d1117] font-bold py-2.5 rounded-lg hover:bg-cyan-300 transition shadow-[0_0_15px_rgba(34,211,238,0.4)]">
            Guardar cita
        </button>
    </form>
</div>
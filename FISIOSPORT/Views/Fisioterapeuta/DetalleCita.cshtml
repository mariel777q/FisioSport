@model FISIOSPORT.Models.DetalleCitaViewModel

@{
    ViewData["Title"] = "Detalle del paciente";

    var colorEstado = Model.EstadoCita switch
    {
        "Confirmada" => "bg-emerald-400/10 text-emerald-400 border-emerald-400/30",
        "Pendiente" => "bg-amber-400/10 text-amber-400 border-amber-400/30",
        "Completada" => "bg-gray-400/10 text-gray-300 border-gray-400/30",
        _ => "bg-red-400/10 text-red-400 border-red-400/30"
    };
}

<div class="mb-6">
    <a asp-controller="Fisioterapeuta"
       asp-action="Dashboard"
       class="text-sm text-gray-400 hover:text-cyan-400 transition">

        ← Volver al dashboard
    </a>
</div>

<div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-8">

    <div>
        <p class="text-sm text-cyan-400 mb-1">Detalle de cita</p>

        <h1 class="text-3xl font-extrabold text-white">
            @Model.NombrePaciente
        </h1>

        <p class="text-gray-400 mt-2">
            @Model.Fecha.ToString("dd MMM yyyy") · @Model.Hora
        </p>
    </div>

    <span class="self-start text-sm px-3 py-1 rounded-full border @colorEstado">
        @Model.EstadoCita
    </span>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <div class="lg:col-span-2 space-y-6">

        <section class="rounded-xl border border-gray-800 bg-[#161b22] p-6">

            <h2 class="text-lg font-bold text-white mb-5">
                Información del paciente
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

                <div>
                    <p class="text-xs text-gray-500 uppercase tracking-wider">
                        Nombre completo
                    </p>

                    <p class="text-gray-100 mt-1">
                        @Model.NombrePaciente
                    </p>
                </div>

                <div>
                    <p class="text-xs text-gray-500 uppercase tracking-wider">
                        Correo electrónico
                    </p>

                    <p class="text-gray-100 mt-1">
                        @Model.CorreoPaciente
                    </p>
                </div>

                <div>
                    <p class="text-xs text-gray-500 uppercase tracking-wider">
                        Teléfono
                    </p>

                    <p class="text-gray-100 mt-1">
                        @Model.TelefonoPaciente
                    </p>
                </div>

                <div>
                    <p class="text-xs text-gray-500 uppercase tracking-wider">
                        Fecha de cita
                    </p>

                    <p class="text-gray-100 mt-1">
                        @Model.Fecha.ToString("dd/MM/yyyy")
                    </p>
                </div>

            </div>

        </section>

        <section class="rounded-xl border border-gray-800 bg-[#161b22] p-6">

            <div class="flex items-center justify-between mb-5">

                <h2 class="text-lg font-bold text-white">
                    Motivo y diagnóstico
                </h2>

            </div>

            <div class="space-y-5">

                <div>
                    <p class="text-xs text-gray-500 uppercase tracking-wider">
                        Motivo de consulta
                    </p>

                    <p class="text-gray-200 mt-2 leading-relaxed">
                        @Model.MotivoConsulta
                    </p>
                </div>

                <div>
                    <p class="text-xs text-gray-500 uppercase tracking-wider">
                        Diagnóstico
                    </p>

                    <p class="text-gray-200 mt-2 leading-relaxed">
                        @Model.Diagnostico
                    </p>
                </div>

                <div>
                    <p class="text-xs text-gray-500 uppercase tracking-wider">
                        Tratamiento
                    </p>

                    <p class="text-gray-200 mt-2 leading-relaxed">
                        @Model.DescripcionTratamiento
                    </p>
                </div>

            </div>

        </section>

        <section class="rounded-xl border border-gray-800 bg-[#161b22] p-6">

            <div class="flex items-center justify-between mb-5">

                <div>
                    <h2 class="text-lg font-bold text-white">
                        Progreso del tratamiento
                    </h2>

                    <p class="text-sm text-gray-400 mt-1">
                        Sesiones completadas y pendientes.
                    </p>
                </div>

                <span class="text-cyan-400 font-bold text-lg">
                    @Model.PorcentajeProgreso%
                </span>

            </div>

            <div class="w-full bg-gray-800 rounded-full h-3 overflow-hidden">

                <div class="bg-cyan-400 h-3 rounded-full transition-all duration-500"
                     style="width: @Model.PorcentajeProgreso%;">
                </div>

            </div>

            <div class="flex justify-between text-sm mt-3">

                <span class="text-emerald-400">
                    @Model.SesionesCompletadas completadas
                </span>

                <span class="text-gray-400">
                    @Model.SesionesRestantes restantes
                </span>

            </div>

        </section>

        <section class="rounded-xl border border-gray-800 bg-[#161b22] p-6">

            <div class="flex items-center justify-between mb-6">

                <div>
                    <h2 class="text-lg font-bold text-white">
                        Sesiones del tratamiento
                    </h2>

                    <p class="text-sm text-gray-400 mt-1">
                        Historial y próximas sesiones.
                    </p>
                </div>

                <span class="text-sm text-gray-400">
                    @Model.SesionesCompletadas/@Model.TotalSesiones
                </span>

            </div>

            @if (!Model.Sesiones.Any())
            {
                <p class="text-gray-500">
                    Este tratamiento todavía no tiene sesiones registradas.
                </p>
            }
            else
            {
                <div class="space-y-3">

                    @foreach (var sesion in Model.Sesiones)
                    {
                        var clase = sesion.EstaCompletada
                            ? "border-emerald-400/30 bg-emerald-400/5"
                            : sesion.EsSesionActual
                                ? "border-cyan-400/50 bg-cyan-400/10"
                                : "border-gray-800 bg-[#0d1117]";

                        <div class="rounded-lg border @clase p-4">

                            <div class="flex items-start gap-3">

                                <div class="flex-shrink-0">

                                    @if (sesion.EstaCompletada)
                                    {
                                        <div class="w-8 h-8 rounded-full bg-emerald-400 text-[#0d1117] flex items-center justify-center font-bold">
                                            ✓
                                        </div>
                                    }
                                    else if (sesion.EsSesionActual)
                                    {
                                        <div class="w-8 h-8 rounded-full bg-cyan-400 text-[#0d1117] flex items-center justify-center font-bold">
                                            @sesion.NumeroSesion
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="w-8 h-8 rounded-full border border-gray-600 text-gray-400 flex items-center justify-center font-bold">
                                            @sesion.NumeroSesion
                                        </div>
                                    }

                                </div>

                                <div class="flex-1">

                                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">

                                        <h3 class="font-semibold text-gray-100">
                                            Sesión @sesion.NumeroSesion
                                        </h3>

                                        @if (sesion.EstaCompletada)
                                        {
                                            <span class="text-xs text-emerald-400">
                                                Completada
                                            </span>
                                        }
                                        else if (sesion.EsSesionActual)
                                        {
                                            <span class="text-xs text-cyan-400 font-semibold">
                                                Próxima sesión
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-gray-500">
                                                Pendiente
                                            </span>
                                        }

                                    </div>

                                    <p class="text-sm text-gray-400 mt-2">
                                        @sesion.TrabajoPlanificado
                                    </p>

                                    @if (sesion.FechaCompletada.HasValue)
                                    {
                                        <p class="text-xs text-gray-500 mt-2">
                                            Completada el
                                            @sesion.FechaCompletada.Value.ToString("dd/MM/yyyy HH:mm")
                                        </p>
                                    }

                                    @if (sesion.EsSesionActual && !sesion.EstaCompletada)
                                    {
                                        <p class="text-xs text-cyan-300 mt-3">
                                            Esta es la sesión que corresponde trabajar actualmente.
                                        </p>
                                    }

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }

        </section>

    </div>

    <div class="space-y-6">

        <section class="rounded-xl border border-cyan-400/20 bg-[#161b22] p-6">

            <p class="text-xs text-gray-500 uppercase tracking-wider">
                Próxima sesión
            </p>

            @if (Model.NumeroSesionActual > 0)
            {
                <h2 class="text-2xl font-extrabold text-cyan-400 mt-2">
                    Sesión @Model.NumeroSesionActual
                </h2>

                <p class="text-sm text-gray-300 mt-4 leading-relaxed">
                    @Model.TrabajoSesionActual
                </p>

                <div class="mt-6 pt-5 border-t border-gray-800">

                    <form asp-controller="Fisioterapeuta"
                          asp-action="CompletarSesion"
                          method="post">

                        <input type="hidden"
                               name="sesionId"
                               value="@Model.SesionActualId" />

                        <input type="hidden"
                               name="citaId"
                               value="@Model.CitaId" />

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="w-full bg-emerald-400 text-[#0d1117] font-bold py-3 rounded-lg hover:bg-emerald-300 transition">

                            ✓ Completar sesión
                        </button>

                    </form>

                </div>
            }
            else
            {
                <p class="text-gray-400 mt-3">
                    No hay sesiones pendientes.
                </p>
            }

        </section>

        <section class="rounded-xl border border-gray-800 bg-[#161b22] p-6">

            <h2 class="text-lg font-bold text-white mb-4">
                Resumen
            </h2>

            <div class="space-y-4">

                <div class="flex justify-between">
                    <span class="text-gray-400 text-sm">
                        Total de sesiones
                    </span>

                    <span class="text-gray-100 font-semibold">
                        @Model.TotalSesiones
                    </span>
                </div>

                <div class="flex justify-between">
                    <span class="text-gray-400 text-sm">
                        Completadas
                    </span>

                    <span class="text-emerald-400 font-semibold">
                        @Model.SesionesCompletadas
                    </span>
                </div>

                <div class="flex justify-between">
                    <span class="text-gray-400 text-sm">
                        Restantes
                    </span>

                    <span class="text-cyan-400 font-semibold">
                        @Model.SesionesRestantes
                    </span>
                </div>

            </div>

        </section>

    </div>

</div>
@model FISIOSPORT.Models.DetalleCitaViewModel

@{
    ViewData["Title"] = "Sesión del paciente";

    var estadoClase = Model.EstadoCita switch
    {
        "Pendiente" =>
            "bg-amber-400/10 text-amber-300 border-amber-400/30",

        "Confirmada" =>
            "bg-emerald-400/10 text-emerald-300 border-emerald-400/30",

        "Completada" =>
            "bg-gray-400/10 text-gray-300 border-gray-400/30",

        _ =>
            "bg-red-400/10 text-red-300 border-red-400/30"
    };
}

<div class="mb-6">

    <a asp-action="Dashboard"
       class="text-sm text-gray-400 hover:text-cyan-400 transition">
        ← Volver al dashboard
    </a>

</div>

<div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between mb-8">

    <div>

        <p class="text-xs font-bold uppercase tracking-[0.2em] text-cyan-400">
            Atención fisioterapéutica
        </p>

        <h1 class="mt-2 text-3xl font-extrabold text-white">
            @Model.NombrePaciente
        </h1>

        <p class="mt-2 text-sm text-gray-400">
            @Model.Fecha.ToString("dd/MM/yyyy") · @Model.Hora
        </p>

        <p class="mt-1 text-xs text-gray-500">
            Expediente: @Model.Expediente
        </p>

    </div>

    <span class="self-start rounded-full border px-4 py-2 text-xs font-bold @estadoClase">
        @Model.EstadoCita
    </span>

</div>

<!-- ============================================================= -->
<!-- HISTORIA CLÍNICA -->
<!-- ============================================================= -->

<section class="rounded-2xl border border-blue-400/20 bg-[#f8fafc] text-slate-900 overflow-hidden mb-8">

    <div class="bg-blue-600 px-6 py-5 text-white flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">

        <div>

            <p class="text-xs font-bold tracking-[0.18em] opacity-80">
                FISIOSPORT
            </p>

            <h2 class="text-xl font-extrabold mt-1">
                HISTORIA CLÍNICA FISIOTERAPIA
            </h2>

        </div>

        <a asp-action="DescargarHistoriaClinica"
           asp-route-pacienteId="@Model.Historia.GetValueOrDefault("IdPaciente")"
           class="inline-flex items-center justify-center rounded-xl bg-white px-4 py-2.5 text-sm font-bold text-blue-700 hover:bg-blue-50 transition">

            <i class="bi bi-file-earmark-pdf mr-2"></i>
            Descargar PDF

        </a>

    </div>

    @if (Model.Historia.Any())
    {
        <div class="p-6 space-y-7">

            <div>

                <h3 class="medical-section-title">
                    Datos del paciente
                </h3>

                <div class="medical-grid">

                    @foreach (var item in Model.Historia.Take(11))
                    {
                        <div class="medical-box">

                            <span>
                                @item.Key
                            </span>

                            <strong>
                                @item.Value
                            </strong>

                        </div>
                    }

                </div>

            </div>

            <div>

                <h3 class="medical-section-title">
                    Información clínica
                </h3>

                <div class="medical-grid">

                    @foreach (var item in Model.Historia.Skip(11))
                    {
                        <div class="medical-box">

                            <span>
                                @item.Key
                            </span>

                            <strong>
                                @item.Value
                            </strong>

                        </div>
                    }

                </div>

            </div>

        </div>
    }
    else
    {
        <div class="p-6 text-sm text-gray-500">
            No hay información clínica disponible.
        </div>
    }

</section>

<!-- ============================================================= -->
<!-- TRATAMIENTO -->
<!-- ============================================================= -->

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <section class="lg:col-span-2 space-y-6">

        <div class="rounded-2xl border border-gray-800 bg-[#161b22] p-6">

            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

                <div>

                    <p class="text-xs uppercase tracking-wider text-gray-500">
                        Tratamiento
                    </p>

                    <h2 class="text-xl font-bold text-white mt-1">
                        Progreso de rehabilitación
                    </h2>

                </div>

                <div class="text-right">

                    <p class="text-3xl font-extrabold text-cyan-400">
                        @Model.PorcentajeProgreso%
                    </p>

                    <p class="text-xs text-gray-500">
                        progreso
                    </p>

                </div>

            </div>

            <div class="mt-6 h-3 w-full overflow-hidden rounded-full bg-gray-800">

                <div class="h-full rounded-full bg-cyan-400 transition-all"
                     style="width:@Model.PorcentajeProgreso%">
                </div>

            </div>

            <div class="mt-4 grid grid-cols-3 gap-3">

                <div class="rounded-xl border border-gray-800 bg-[#0d1117] p-4 text-center">

                    <p class="text-2xl font-extrabold text-white">
                        @Model.TotalSesiones
                    </p>

                    <p class="text-xs text-gray-500 mt-1">
                        Total
                    </p>

                </div>

                <div class="rounded-xl border border-emerald-400/20 bg-emerald-400/5 p-4 text-center">

                    <p class="text-2xl font-extrabold text-emerald-400">
                        @Model.SesionesCompletadas
                    </p>

                    <p class="text-xs text-gray-500 mt-1">
                        Completadas
                    </p>

                </div>

                <div class="rounded-xl border border-cyan-400/20 bg-cyan-400/5 p-4 text-center">

                    <p class="text-2xl font-extrabold text-cyan-400">
                        @Model.SesionesRestantes
                    </p>

                    <p class="text-xs text-gray-500 mt-1">
                        Restantes
                    </p>

                </div>

            </div>

        </div>

        <!-- SESIÓN ACTUAL -->

        @if (Model.NumeroSesionActual > 0 && Model.EstadoCita != "Completada")
        {
            <section class="rounded-2xl border border-cyan-400/30 bg-[#111820] p-6">

                <div class="flex items-center gap-3 mb-5">

                    <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-cyan-400 text-[#071017] font-extrabold">
                        @Model.NumeroSesionActual
                    </div>

                    <div>

                        <p class="text-xs uppercase tracking-wider text-cyan-400">
                            Sesión actual
                        </p>

                        <h2 class="text-xl font-bold text-white">
                            Sesión @Model.NumeroSesionActual
                        </h2>

                    </div>

                </div>

                <div class="rounded-xl border border-gray-800 bg-[#0d1117] p-5">

                    <p class="text-xs uppercase tracking-wider text-gray-500">
                        Trabajo planificado
                    </p>

                    <p class="mt-2 text-sm leading-7 text-gray-200">
                        @Model.TrabajoSesionActual
                    </p>

                </div>

                <form asp-action="CompletarSesion"
                      method="post"
                      class="mt-5">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="sesionId"
                           value="@Model.SesionActualId" />

                    <input type="hidden"
                           name="citaId"
                           value="@Model.CitaId" />

                    <label class="field-label">
                        Observaciones de la sesión
                        <span class="text-gray-500 font-normal">
                            (opcional)
                        </span>
                    </label>

                    <textarea id="observaciones"
                              name="observaciones"
                              rows="5"
                              class="field-input"
                              placeholder="Escribe aquí lo ocurrido durante esta sesión, respuesta del paciente, evolución, ejercicios realizados, etc."></textarea>
                    <button type="button"
                            data-fisiosport-speech
                            data-speech-target="#observaciones"
                            class="mt-2 inline-flex items-center gap-2 rounded-lg border border-cyan-400/30 px-3 py-2 text-xs font-semibold text-cyan-300 transition hover:bg-cyan-400/10">
                        🎙️ Dictar
                    </button>
                    <button type="submit"
                            class="mt-4 w-full rounded-xl bg-emerald-400 px-5 py-3.5 font-extrabold text-[#071017] hover:bg-emerald-300 transition">

                        ✓ Completar sesión

                    </button>

                    <p class="mt-3 text-center text-xs text-gray-500">
                        Al completar la sesión, la cita cambiará a Completada,
                        el contador se actualizará y esta cita dejará de aparecer
                        en el dashboard principal.
                    </p>

                </form>

            </section>
        }
        else if (Model.EstadoCita == "Completada")
        {
            <section class="rounded-2xl border border-emerald-400/20 bg-emerald-400/5 p-6">

                <div class="flex items-center gap-3">

                    <div class="flex h-12 w-12 items-center justify-center rounded-full bg-emerald-400 text-[#071017] text-xl font-bold">
                        ✓
                    </div>

                    <div>

                        <h2 class="font-bold text-emerald-300">
                            Sesión completada con éxito
                        </h2>

                        <p class="text-sm text-gray-400 mt-1">
                            Esta sesión ya fue registrada como completada.
                        </p>

                    </div>

                </div>

            </section>
        }

        <!-- HISTORIAL DE SESIONES -->

        <section class="rounded-2xl border border-gray-800 bg-[#161b22] p-6">

            <div class="mb-5">

                <h2 class="text-lg font-bold text-white">
                    Seguimiento de sesiones
                </h2>

                <p class="text-sm text-gray-500 mt-1">
                    Historial del tratamiento.
                </p>

            </div>

            <div class="space-y-3">

                @foreach (var sesion in Model.Sesiones)
                {
                    var clase =
                        sesion.EstaCompletada
                            ? "border-emerald-400/20 bg-emerald-400/5"
                            : sesion.EsSesionActual
                                ? "border-cyan-400/30 bg-cyan-400/5"
                                : "border-gray-800 bg-[#0d1117]";

                    <div class="rounded-xl border @clase p-4">

                        <div class="flex items-start gap-4">

                            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-gray-700 text-sm font-bold text-gray-300">

                                @if (sesion.EstaCompletada)
                                {
                                    <span class="text-emerald-400">✓</span>
                                }
                                else
                                {
                                    @sesion.NumeroSesion
                                }

                            </div>

                            <div class="min-w-0 flex-1">

                                <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">

                                    <h3 class="font-bold text-gray-100">
                                        Sesión @sesion.NumeroSesion
                                    </h3>

                                    <span class="text-xs @(sesion.EstaCompletada ? "text-emerald-400" : "text-gray-500")">
                                        @(sesion.EstaCompletada ? "Completada" : "Pendiente")
                                    </span>

                                </div>

                                <p class="mt-2 text-sm text-gray-400">
                                    @sesion.TrabajoPlanificado
                                </p>

                                @if (!string.IsNullOrWhiteSpace(sesion.Observaciones))
                                {
                                    <div class="mt-3 rounded-lg border border-gray-800 bg-[#0d1117] p-3">

                                        <p class="text-[11px] uppercase tracking-wider text-gray-600">
                                            Observaciones
                                        </p>

                                        <p class="mt-1 text-sm text-gray-300 whitespace-pre-wrap">
                                            @sesion.Observaciones
                                        </p>

                                    </div>
                                }

                                @if (sesion.FechaCompletada.HasValue)
                                {
                                    <p class="mt-2 text-xs text-gray-600">
                                        Completada:
                                        @sesion.FechaCompletada.Value.ToString("dd/MM/yyyy HH:mm")
                                    </p>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>

        </section>

    </section>

    <!-- RESUMEN -->

    <aside class="space-y-6">

        <section class="rounded-2xl border border-gray-800 bg-[#161b22] p-6">

            <p class="text-xs uppercase tracking-wider text-gray-500">
                Paciente
            </p>

            <h2 class="mt-2 text-xl font-bold text-white">
                @Model.NombrePaciente
            </h2>

            <div class="mt-5 space-y-3 text-sm">

                <div>
                    <span class="text-gray-500">
                        Correo
                    </span>

                    <p class="text-gray-200 mt-1 break-all">
                        @Model.CorreoPaciente
                    </p>
                </div>

                <div>
                    <span class="text-gray-500">
                        Teléfono
                    </span>

                    <p class="text-gray-200 mt-1">
                        @Model.TelefonoPaciente
                    </p>
                </div>

                <div>
                    <span class="text-gray-500">
                        Expediente
                    </span>

                    <p class="text-cyan-400 font-bold mt-1">
                        @Model.Expediente
                    </p>
                </div>

            </div>

        </section>
        <!-- ============================================================= -->
<!-- EJERCICIOS DEL PACIENTE -->
<!-- ============================================================= -->

<section class="rounded-2xl border border-gray-800 bg-[#161b22] p-6">

    <div id="ejercicios-cita-contenido">

        <div class="flex items-center gap-3">

            <div class="h-5 w-5 animate-spin rounded-full border-2 border-gray-700 border-t-cyan-400">
            </div>

            <p class="text-sm text-gray-500">
                Cargando ejercicios...
            </p>

        </div>

    </div>

</section>

<script>

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            const contenedor =
                document.getElementById(
                    "ejercicios-cita-contenido"
                );

            if (!contenedor) {
                return;
            }

            fetch(
                '@Url.Action(
                    "PendientesCita",
                    "Ejercicios",
                    new { citaId = Model.CitaId }
                )'
            )
            .then(function (response) {

                if (!response.ok) {
                    throw new Error(
                        "No se pudieron cargar los ejercicios."
                    );
                }

                return response.text();
            })
            .then(function (html) {

                contenedor.innerHTML = html;

            })
            .catch(function () {

                contenedor.innerHTML =
                    '<div class="rounded-xl border border-red-400/20 bg-red-400/5 p-4">' +
                    '<p class="text-sm text-red-300">' +
                    'No se pudieron cargar los ejercicios.' +
                    '</p>' +
                    '</div>';

            });

        }
    );

</script>

    </aside>

</div>

<style>

    .field-label {
        display: block;
        margin-bottom: .5rem;
        color: #d1d5db;
        font-size: .82rem;
        font-weight: 700;
    }

    .field-input {
        width: 100%;
        border-radius: .75rem;
        border: 1px solid #374151;
        background: #0d1117;
        color: white;
        padding: .75rem 1rem;
        outline: none;
    }

    .field-input:focus {
        border-color: #22d3ee;
        box-shadow: 0 0 0 2px rgba(34, 211, 238, .12);
    }

    .medical-section-title {
        color: #2563eb;
        font-size: .75rem;
        font-weight: 900;
        letter-spacing: .14em;
        text-transform: uppercase;
        margin-bottom: 1rem;
        border-bottom: 1px solid #dbeafe;
        padding-bottom: .6rem;
    }

    .medical-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: .65rem;
    }

    .medical-box {
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        border-radius: .7rem;
        padding: .75rem;
    }

    .medical-box span {
        display: block;
        color: #64748b;
        font-size: .65rem;
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-bottom: .25rem;
    }

    .medical-box strong {
        display: block;
        color: #0f172a;
        font-size: .83rem;
        line-height: 1.5;
        white-space: pre-wrap;
        word-break: break-word;
    }

    @@media (min-width: 768px) {

        .medical-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

    }

</style>
@section Scripts
{
    <script src="~/js/fisiosport-speech.js"></script>
}
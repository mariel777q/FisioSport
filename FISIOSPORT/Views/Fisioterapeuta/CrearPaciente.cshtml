                                       class="accent-cyan-400" />
                                No
                            </label>
                        </div>
                    </div>

                    <div class="rounded-xl border border-slate-800 bg-slate-950 p-4">
                        <span class="mb-3 block font-semibold">Con ayuda</span>

                        <div class="flex gap-4">
                            <label class="flex items-center gap-2">
                                <input asp-for="MarchaConAyuda"
                                       type="radio"
                                       value="true"
                                       class="accent-cyan-400" />
                                Sí
                            </label>

                            <label class="flex items-center gap-2">
                                <input asp-for="MarchaConAyuda"
                                       type="radio"
                                       value="false"
                                       class="accent-cyan-400" />
                                No
                            </label>
                        </div>
                    </div>

                    <div class="rounded-xl border border-slate-800 bg-slate-950 p-4">
                        <span class="mb-3 block font-semibold">Espástica</span>

                        <div class="flex gap-4">
                            <label class="flex items-center gap-2">
                                <input asp-for="MarchaEspastica"
                                       type="radio"
                                       value="true"
                                       class="accent-cyan-400" />
                                Sí
                            </label>

                            <label class="flex items-center gap-2">
                                <input asp-for="MarchaEspastica"
                                       type="radio"
                                       value="false"
                                       class="accent-cyan-400" />
                                No
                            </label>
                        </div>
                    </div>

                    <div class="rounded-xl border border-slate-800 bg-slate-950 p-4">
                        <span class="mb-3 block font-semibold">Atáxica</span>

                        <div class="flex gap-4">
                            <label class="flex items-center gap-2">
                                <input asp-for="MarchaAtaxica"
                                       type="radio"
                                       value="true"
                                       class="accent-cyan-400" />
                                Sí
                            </label>

                            <label class="flex items-center gap-2">
                                <input asp-for="MarchaAtaxica"
                                       type="radio"
                                       value="false"
                                       class="accent-cyan-400" />
                                No
                            </label>
                        </div>
                    </div>

                    <div class="rounded-xl border border-slate-800 bg-slate-950 p-4">
                        <span class="mb-3 block font-semibold">Otros</span>

                        <div class="flex gap-4">
                            <label class="flex items-center gap-2">
                                <input asp-for="MarchaOtros"
                                       type="radio"
                                       value="true"
                                       class="accent-cyan-400" />
                                Sí
                            </label>

                            <label class="flex items-center gap-2">
                                <input asp-for="MarchaOtros"
                                       type="radio"
                                       value="false"
                                       class="accent-cyan-400" />
                                No
                            </label>
                        </div>
                    </div>

                </div>

                <div class="mt-5">
                    <label asp-for="ObservacionesMarcha"
                           class="mb-2 block text-sm font-semibold text-slate-300">
                    </label>

                    <textarea asp-for="ObservacionesMarcha"
                              rows="4"
                              class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none focus:border-cyan-400"
                              placeholder="Observaciones de la marcha"></textarea>

                    <span asp-validation-for="ObservacionesMarcha"
                          class="mt-1 block text-sm text-red-400">
                    </span>
                </div>

            </section>


            <!-- ========================================================= -->
            <!-- ESCALA DEL DOLOR -->
            <!-- ========================================================= -->

            <section class="rounded-2xl border border-slate-800 bg-slate-900 p-6 shadow-xl">

                <h2 class="mb-2 text-xl font-bold">
                    Escala del dolor
                </h2>

                <p class="mb-6 text-sm text-slate-400">
                    Selecciona el nivel de dolor actual del paciente.
                </p>

                <div class="grid grid-cols-6 gap-2 sm:grid-cols-11">

                    @for (var dolor = 0; dolor <= 10; dolor++)
                    {
                        <label class="cursor-pointer">

                            <input asp-for="EscalaDolor"
                                   type="radio"
                                   value="@dolor"
                                   class="peer sr-only" />

                            <span class="flex h-12 items-center justify-center rounded-lg border border-slate-700 bg-slate-950 font-bold text-slate-300 transition hover:border-cyan-400 peer-checked:border-cyan-400 peer-checked:bg-cyan-500 peer-checked:text-slate-950">
                                @dolor
                            </span>

                        </label>
                    }

                </div>

                <div class="mt-4 grid grid-cols-2 gap-2 text-xs text-slate-400 sm:grid-cols-4">
                    <span>0 · Sin dolor</span>
                    <span>3–5 · Moderado</span>
                    <span>6–7 · Fuerte</span>
                    <span>9–10 · Insoportable</span>
                </div>

                <span asp-validation-for="EscalaDolor"
                      class="mt-3 block text-sm text-red-400">
                </span>

            </section>


            <!-- ========================================================= -->
            <!-- INFORMACIÓN GENERAL -->
            <!-- ========================================================= -->

            <section class="rounded-2xl border border-slate-800 bg-slate-900 p-6 shadow-xl">

                <h2 class="mb-6 text-xl font-bold">
                    Información general
                </h2>

                <div class="space-y-5">

                    <div>
                        <label asp-for="Antecedentes"
                               class="mb-2 block text-sm font-semibold text-slate-300">
                        </label>

                        <textarea asp-for="Antecedentes"
                                  rows="4"
                                  class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none focus:border-cyan-400"
                                  placeholder="Antecedentes generales del paciente"></textarea>

                        <span asp-validation-for="Antecedentes"
                              class="mt-1 block text-sm text-red-400">
                        </span>
                    </div>

                    <div>
                        <label asp-for="Alergias"
                               class="mb-2 block text-sm font-semibold text-slate-300">
                        </label>

                        <textarea asp-for="Alergias"
                                  rows="3"
                                  class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none focus:border-cyan-400"
                                  placeholder="Alergias generales conocidas"></textarea>

                        <span asp-validation-for="Alergias"
                              class="mt-1 block text-sm text-red-400">
                        </span>
                    </div>

                    <div>
                        <label asp-for="Observaciones"
                               class="mb-2 block text-sm font-semibold text-slate-300">
                        </label>

                        <textarea asp-for="Observaciones"
                                  rows="4"
                                  class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none focus:border-cyan-400"
                                  placeholder="Observaciones generales del fisioterapeuta"></textarea>

                        <span asp-validation-for="Observaciones"
                              class="mt-1 block text-sm text-red-400">
                        </span>
                    </div>


                </div>
            </section>


            <!-- ========================================================= -->
            <!-- ACCIONES -->
            <!-- ========================================================= -->

            <div class="flex flex-col-reverse gap-3 border-t border-slate-800 pt-6 sm:flex-row sm:justify-end">

                <a asp-controller="Fisioterapeuta"
                   asp-action="Dashboard"
                   class="rounded-xl border border-slate-700 px-6 py-3 text-center font-semibold text-slate-300 transition hover:border-slate-500 hover:text-white">
                    Cancelar
                </a>

                <button type="submit"
                        class="rounded-xl bg-cyan-500 px-6 py-3 font-bold text-slate-950 shadow-lg shadow-cyan-500/10 transition hover:bg-cyan-400">
                    Guardar paciente, historia clínica y primera cita
                </button>

            </div>

        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

}
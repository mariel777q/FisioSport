                setValue(k, data[k]);
            });
        }

        function clearAll(){
            var inputs = document.querySelectorAll('#historiaForm [name]');
            inputs.forEach(function(i){
                try{
                    if(i.type === 'radio' || i.type === 'checkbox') i.checked = false;
                    else i.value = '';
                    i.dispatchEvent(new Event('input',{bubbles:true}));
                    i.dispatchEvent(new Event('change',{bubbles:true}));
                }catch(e){ }
            });
        }

        document.addEventListener('DOMContentLoaded', function(){
            var btn = document.getElementById('btnFillTestData');
            if(btn) btn.addEventListener('click', function(e){ e.preventDefault(); fillAll(); });


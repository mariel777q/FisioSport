@model FISIOSPORT.Models.CrearPacienteViewModel

@{
    ViewData["Title"] = "Registrar paciente";
}

<div class="min-h-screen bg-[#0d1117] text-gray-100 py-8 px-4 sm:px-6">

    <div class="max-w-6xl mx-auto">

        <!-- ENCABEZADO -->
        <div class="mb-8">
            <a asp-controller="Fisioterapeuta"
               asp-action="Dashboard"
               class="inline-flex items-center gap-2 text-sm text-gray-400 hover:text-cyan-400 transition mb-5">
                ← Volver al dashboard
            </a>

            <div class="rounded-2xl border border-cyan-400/20 bg-[#111820] p-6 sm:p-8 shadow-[0_0_35px_rgba(34,211,238,0.06)]">

                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">

                    <div>
                        <p class="text-cyan-400 text-xs font-bold uppercase tracking-[0.2em] mb-2">
                            FISIOSPORT
                        </p>

                        <h1 class="text-2xl sm:text-3xl font-bold text-white">
                            Historia Clínica Fisioterapia
                        </h1>

                        <p class="text-gray-400 mt-2 text-sm">
                            Registro inicial del paciente y evaluación fisioterapéutica.
                        </p>
                    </div>

                    <div class="hidden sm:flex w-14 h-14 rounded-xl bg-cyan-400/10 border border-cyan-400/20 items-center justify-center text-2xl">
                        🩺
                    </div>

                </div>

            </div>
        </div>


        <!-- FORMULARIO -->
        <form asp-controller="Fisioterapeuta"
              asp-action="CrearPaciente"
              method="post"
              id="historiaForm"
              class="space-y-6">

            <div class="flex gap-3 mb-4">
                <button type="button" id="btnFillTestData" class="px-4 py-2 rounded-lg bg-amber-500 text-black font-semibold">Cargar datos de prueba</button>
                <button type="button" id="btnClearTestData" class="px-4 py-2 rounded-lg border border-slate-700 text-slate-300">Limpiar datos de prueba</button>
            </div>

            @Html.AntiForgeryToken()

            <!-- Campo oculto para mostrar errores asociados a OtrosHallazgos (JSON funcional) -->
            <input asp-for="OtrosHallazgos" type="hidden" />

            <!-- ERRORES GENERALES -->
            <div asp-validation-summary="All"
                 class="rounded-xl border border-red-500/30 bg-red-500/10 text-red-300 px-5 py-4 text-sm">
            </div>


            <!-- ===================================================== -->
            <!-- 01. DATOS DEL PACIENTE -->
            <!-- ===================================================== -->

            <section class="medical-card">

                <div class="section-header">
                    <div class="section-number">01</div>

                    <div>
                        <h2>Datos del paciente</h2>
                        <p>Información personal y administrativa.</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mt-6">

                    <div>
                        <label asp-for="Nombre" class="field-label">
                            Nombre completo *
                        </label>

                        <input asp-for="Nombre"
                               class="field-input"
                               placeholder="Nombre completo" />

                        <span asp-validation-for="Nombre" class="field-error"></span>
                    </div>


                    <div>
                        <label asp-for="Correo" class="field-label">
                            Correo electrónico *
                        </label>

                        <input asp-for="Correo"
                               type="email"
                               class="field-input"
                               placeholder="correo@ejemplo.com" />

                        <span asp-validation-for="Correo" class="field-error"></span>
                    </div>


                    <div>
                        <label asp-for="Telefono" class="field-label">
                            Teléfono *
                        </label>

                        <input asp-for="Telefono"
                               class="field-input"
                               placeholder="Número telefónico" />

                        <span asp-validation-for="Telefono" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="ContactoEmergencia" class="field-label">
                            Contacto de emergencia *
                        </label>

                        <input asp-for="ContactoEmergencia"
                               class="field-input"
                               placeholder="Nombre y teléfono del contacto" />

                        <span asp-validation-for="ContactoEmergencia"
                              class="field-error"></span>
                    </div>

                    <div>
                        <label asp-for="Password" class="field-label">
                            Contraseña *
                        </label>

                        <input asp-for="Password"
                               type="password"
                               class="field-input"
                               placeholder="Contraseña del paciente" />

                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>


                    <div>
                        <label asp-for="Domicilio" class="field-label">
                            Domicilio *
                        </label>

                        <input asp-for="Domicilio"
                               class="field-input"
                               placeholder="Domicilio del paciente" />

                        <span asp-validation-for="Domicilio" class="field-error"></span>
                    </div>


                    <div>
                        <label asp-for="Ocupacion" class="field-label">
                            Ocupación *
                        </label>

                        <input asp-for="Ocupacion"
                               class="field-input"
                               placeholder="Ocupación" />

                        <span asp-validation-for="Ocupacion" class="field-error"></span>
                    </div>


                    <div>
                        <label asp-for="Sexo" class="field-label">
                            Sexo *
                        </label>

                        <select asp-for="Sexo" class="field-input">
                            <option value="">Seleccionar</option>
                            <option value="Femenino">Femenino</option>
                            <option value="Masculino">Masculino</option>
                            <option value="Otro">Otro</option>
                        </select>

                        <span asp-validation-for="Sexo" class="field-error"></span>
                    </div>


                    <div>
                        <label asp-for="Edad" class="field-label">
                            Edad *
                        </label>

                        <input asp-for="Edad"
                               type="number"
                               min="1"
                               max="120"
                               class="field-input"
                               placeholder="Edad" />

                        <span asp-validation-for="Edad" class="field-error"></span>
                    </div>


                    <div>
                        <label asp-for="EstadoCivil" class="field-label">
                            Estado civil *
                        </label>

                        <select asp-for="EstadoCivil" class="field-input">
                            <option value="">Seleccionar</option>
                            <option value="Soltero/a">Soltero/a</option>
                            <option value="Casado/a">Casado/a</option>
                            <option value="Divorciado/a">Divorciado/a</option>
                            <option value="Viudo/a">Viudo/a</option>
                            <option value="Unión libre">Unión libre</option>
                            <option value="Otro">Otro</option>
                        </select>

                        <span asp-validation-for="EstadoCivil" class="field-error"></span>
                    </div>


                    <div>
                        <label asp-for="Escolaridad" class="field-label">
                            Escolaridad *
                        </label>

                        <input asp-for="Escolaridad"
                               class="field-input"
                               placeholder="Nivel de escolaridad" />

                        <span asp-validation-for="Escolaridad" class="field-error"></span>
                    </div>


                </div>

            </section>


            <!-- ===================================================== -->
            <!-- 02. EXPLORACIÓN FÍSICA -->
            <!-- ===================================================== -->

            <section class="medical-card">

                <div class="section-header">
                    <div class="section-number">02</div>

                    <div>
                        <h2>Exploración física</h2>
                        <p>Medidas antropométricas y características generales.</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mt-6">

                    <div>
                        <label asp-for="Peso" class="field-label">
                            Peso *
                        </label>

                        <div class="relative">
                            <input asp-for="Peso"
                                   type="number"
                                   step="0.01"
                                   class="field-input pr-14"
                                   placeholder="0.00" />
                            <span class="unit">kg</span>
                        </div>

                        <span asp-validation-for="Peso" class="field-error"></span>
                    </div>


                    <div>
                        <label asp-for="Talla" class="field-label">
                            Talla *
                        </label>

                        <input asp-for="Talla"
                               type="number"
                               step="0.01"
                               class="field-input"
                               placeholder="0.00" />

                        <span asp-validation-for="Talla" class="field-error"></span>
                    </div>


                    <div>
                        <label asp-for="Estatura" class="field-label">
                            Estatura *
                        </label>

                        <div class="relative">
                            <input asp-for="Estatura"
                                   type="number"
                                   step="0.01"
                                   class="field-input pr-14"
                                   placeholder="0.00" />
                            <span class="unit">cm</span>
                        </div>

                        <span asp-validation-for="Estatura" class="field-error"></span>
                    </div>


                    <div>
                        <label asp-for="IMC" class="field-label">
                            IMC *
                        </label>

                        <input asp-for="IMC"
                               type="number"
                               step="0.01"
                               class="field-input"
                               placeholder="0.00" />

                        <span asp-validation-for="IMC" class="field-error"></span>
                    </div>


                    <div>
                        <label asp-for="Etnia" class="field-label">
                            Etnia *
                        </label>

                        <input asp-for="Etnia"
                               class="field-input"
                               placeholder="Etnia" />

                        <span asp-validation-for="Etnia" class="field-error"></span>
                    </div>

                </div>

            </section>


            <!-- ===================================================== -->
            <!-- 03. MOTIVO -->
            <!-- ===================================================== -->

            <section class="medical-card">

                <div class="section-header">
                    <div class="section-number">03</div>

                    <div>
                        <h2>Motivo de consulta</h2>
                        <p>Razón principal de la atención fisioterapéutica.</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mt-6">

                    <div>
                        <label asp-for="MotivoConsulta" class="field-label">
                            Motivo de la consulta *
                        </label>

                        <textarea asp-for="MotivoConsulta"
                                  rows="5"
                                  class="field-input"
                                  placeholder="Describe el motivo principal de consulta..."></textarea>

                        <span asp-validation-for="MotivoConsulta" class="field-error"></span>
                    </div>


                    <div>
                        <label asp-for="TratamientosPrevios" class="field-label">
                            Tratamientos previos *
                        </label>

                        <textarea asp-for="TratamientosPrevios"
                                  rows="5"
                                  class="field-input"
                                  placeholder="Indica tratamientos previos, terapias, medicamentos o procedimientos..."></textarea>

                        <span asp-validation-for="TratamientosPrevios" class="field-error"></span>
                    </div>

                </div>

            </section>


            <!-- ===================================================== -->
            <!-- 04. ANTECEDENTES -->
            <!-- ===================================================== -->

            <section class="medical-card">

                <div class="section-header">
                    <div class="section-number">04</div>

                    <div>
                        <h2>Antecedentes patológicos y heredofamiliares</h2>
                        <p>Selecciona Sí o No en cada antecedente.</p>
                    </div>
                </div>

                <div class="antecedentes-grid mt-4">

                    <div class="yesno-card">
                        <div class="yesno-title">Diabetes *</div>

                        <div class="radio-group">
                            <label>
                                <input type="radio" asp-for="Diabetes" value="true" />
                                Sí
                            </label>

                            <label>
                                <input type="radio" asp-for="Diabetes" value="false" />
                                No
                            </label>
                        </div>

                        <input asp-for="EspecificacionDiabetes"
                               class="field-input small-input"
                               placeholder="Especifique" />

                        <span asp-validation-for="Diabetes" class="field-error"></span>
                        <span asp-validation-for="EspecificacionDiabetes" class="field-error"></span>
                    </div>


                    <div class="yesno-card">
                        <div class="yesno-title">Alergia *</div>

                        <div class="radio-group">
                            <label>
                                <input type="radio" asp-for="Alergia" value="true" />
                                Sí
                            </label>

                            <label>
                                <input type="radio" asp-for="Alergia" value="false" />
                                No
                            </label>
                        </div>

                        <input asp-for="EspecificacionAlergia"
                                  class="field-input small-input"
                                  placeholder="Especifique" />

                        <span asp-validation-for="Alergia" class="field-error"></span>
                        <span asp-validation-for="EspecificacionAlergia" class="field-error"></span>
                    </div>


                    <div class="yesno-card">
                        <div class="yesno-title">HTA *</div>

                        <div class="radio-group">
                            <label>
                                <input type="radio" asp-for="HTA" value="true" />
                                Sí
                            </label>

                            <label>
                                <input type="radio" asp-for="HTA" value="false" />
                                No
                            </label>
                        </div>

                        <input asp-for="EspecificacionHTA"
                               class="field-input small-input"
                               placeholder="Especifique" />
                    </div>


                    <div class="yesno-card">
                        <div class="yesno-title">Cáncer *</div>

                        <div class="radio-group">
                            <label>
                                <input type="radio" asp-for="Cancer" value="true" />
                                Sí
                            </label>

                            <label>
                                <input type="radio" asp-for="Cancer" value="false" />
                                No
                            </label>
                        </div>

                        <input asp-for="EspecificacionCancer"
                               class="field-input small-input"
                               placeholder="Especifique" />
                    </div>


                    <div class="yesno-card">
                        <div class="yesno-title">Transfusiones *</div>

                        <div class="radio-group">
                            <label>
                                <input type="radio" asp-for="Transfusiones" value="true" />
                                Sí
                            </label>

                            <label>
                                <input type="radio" asp-for="Transfusiones" value="false" />
                                No
                            </label>
                        </div>

                        <input asp-for="EspecificacionTransfusiones"
                               class="field-input small-input"
                               placeholder="Especifique" />
                    </div>


                    <div class="yesno-card">
                        <div class="yesno-title">Enf. reumáticas *</div>

                        <div class="radio-group">
                            <label>
                                <input type="radio" asp-for="EnfermedadesReumaticas" value="true" />
                                Sí
                            </label>

                            <label>
                                <input type="radio" asp-for="EnfermedadesReumaticas" value="false" />
                                No
                            </label>
                        </div>

                        <input asp-for="EspecificacionEnfermedadesReumaticas"
                               class="field-input small-input"
                               placeholder="Especifique" />
                    </div>


                    <div class="yesno-card">
                        <div class="yesno-title">Encames *</div>

                        <div class="radio-group">
                            <label>
                                <input type="radio" asp-for="Encames" value="true" />
                                Sí
                            </label>

                            <label>
                                <input type="radio" asp-for="Encames" value="false" />
                                No
                            </label>
                        </div>

                        <input asp-for="EspecificacionEncames"
                               class="field-input small-input"
                               placeholder="Especifique" />
                    </div>


                    <div class="yesno-card">
                        <div class="yesno-title">Accidentes *</div>

                        <div class="radio-group">
                            <label>
                                <input type="radio" asp-for="Accidentes" value="true" />
                                Sí
                            </label>

                            <label>
                                <input type="radio" asp-for="Accidentes" value="false" />
                                No
                            </label>
                        </div>

                        <input asp-for="EspecificacionAccidentes"
                               class="field-input small-input"
                               placeholder="Especifique" />
                    </div>


                    <div class="yesno-card">
                        <div class="yesno-title">Cardiopatías *</div>

                        <div class="radio-group">
                            <label>
                                <input type="radio" asp-for="Cardiopatias" value="true" />
                                Sí
                            </label>

                            <label>
                                <input type="radio" asp-for="Cardiopatias" value="false" />
                                No
                            </label>
                        </div>

                        <input asp-for="EspecificacionCardiopatias"
                               class="field-input small-input"
                               placeholder="Especifique" />
                    </div>


                    <div class="yesno-card">
                        <div class="yesno-title">Cirugías *</div>

                        <div class="radio-group">
                            <label>
                                <input type="radio" asp-for="Cirugias" value="true" />
                                Sí
                            </label>

                            <label>
                                <input type="radio" asp-for="Cirugias" value="false" />
                                No
                            </label>
                        </div>

                        <input asp-for="EspecificacionCirugias"
                               class="field-input small-input"
                               placeholder="Especifique" />
                    </div>


                    <div class="yesno-card">
                        <div class="yesno-title">Fracturas *</div>

                        <div class="radio-group">
                            <label>
                                <input type="radio" asp-for="Fracturas" value="true" />
                                Sí
                            </label>

                            <label>
                                <input type="radio" asp-for="Fracturas" value="false" />
                                No
                            </label>
                        </div>

                        <input asp-for="TipoFractura"
                               class="field-input small-input"
                               placeholder="Tipo de FX" />
                    </div>

                </div>

            </section>


            <!-- ===================================================== -->
            <!-- 05. SIGNOS VITALES -->
            <!-- ===================================================== -->

            <section class="medical-card">

                <div class="section-header">
                    <div class="section-number">05</div>

                    <div>
                        <h2>Signos vitales</h2>
                        <p>Registro inicial de signos vitales y condición muscular.</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">

                    <div>
                        <label asp-for="TA" class="field-label">T/A *</label>
                        <input asp-for="TA"
                               class="field-input"
                               placeholder="Ej. 120/80 mmHg" />
                        <span asp-validation-for="TA" class="field-error"></span>
                    </div>

                    <div>
                        <label asp-for="Temperatura" class="field-label">TEMP *</label>
                        <input asp-for="Temperatura"
                               type="number"
                               step="0.1"
                               class="field-input"
                               placeholder="Ej. 36.5" />
                        <span asp-validation-for="Temperatura" class="field-error"></span>
                    </div>

                    <div>
                        <label asp-for="FC" class="field-label">FC *</label>
                        <input asp-for="FC"
                               type="number"
                               class="field-input"
                               placeholder="lpm" />
                        <span asp-validation-for="FC" class="field-error"></span>
                    </div>

                    <div>
                        <label asp-for="FR" class="field-label">FR *</label>
                        <input asp-for="FR"
                               type="number"
                               class="field-input"
                               placeholder="rpm" />
                        <span asp-validation-for="FR" class="field-error"></span>
                    </div>

                </div>

                <div class="mt-5">
                    <label asp-for="EspasmosContracturaMuscular" class="field-label">
                        Espasmos o contractura muscular *
                    </label>

                    <textarea asp-for="EspasmosContracturaMuscular"
                              rows="3"
                              class="field-input"
                              placeholder="Describe presencia, localización y características..."></textarea>

                    <span asp-validation-for="EspasmosContracturaMuscular" class="field-error"></span>
                </div>

            </section>


            <!-- ===================================================== -->
            <!-- 06. HÁBITOS -->
            <!-- ===================================================== -->

            <section class="medical-card">

                <div class="section-header">
                    <div class="section-number">06</div>

                    <div>
                        <h2>Hábitos de salud</h2>
                        <p>Selecciona Sí o No para cada hábito.</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mt-6">

                    <div class="habit-card">
                        <span>Tabaquismo *</span>
                        <div class="radio-group">
                            <label><input type="radio" asp-for="Tabaquismo" value="true" /> Sí</label>
                            <label><input type="radio" asp-for="Tabaquismo" value="false" /> No</label>
                        </div>
                    </div>

                    <div class="habit-card">
                        <span>Alcoholismo *</span>
                        <div class="radio-group">
                            <label><input type="radio" asp-for="Alcoholismo" value="true" /> Sí</label>
                            <label><input type="radio" asp-for="Alcoholismo" value="false" /> No</label>
                        </div>
                    </div>

                    <div class="habit-card">
                        <span>Drogas *</span>
                        <div class="radio-group">
                            <label><input type="radio" asp-for="Drogas" value="true" /> Sí</label>
                            <label><input type="radio" asp-for="Drogas" value="false" /> No</label>
                        </div>
                    </div>

                    <div class="habit-card">
                        <span>Actividad física *</span>
                        <div class="radio-group">
                            <label><input type="radio" asp-for="ActividadFisica" value="true" /> Sí</label>
                            <label><input type="radio" asp-for="ActividadFisica" value="false" /> No</label>
                        </div>
                    </div>

                    <div class="habit-card">
                        <span>Se automedica *</span>
                        <div class="radio-group">
                            <label><input type="radio" asp-for="SeAutomedica" value="true" /> Sí</label>
                            <label><input type="radio" asp-for="SeAutomedica" value="false" /> No</label>
                        </div>
                    </div>

                </div>

                <div class="mt-5">
                    <label asp-for="Pasatiempo" class="field-label">
                        Pasatiempo *
                    </label>

                    <input asp-for="Pasatiempo"
                           class="field-input"
                           placeholder="Pasatiempo o actividad recreativa" />

                    <span asp-validation-for="Pasatiempo" class="field-error"></span>
                </div>

            </section>


            <!-- ===================================================== -->
            <!-- 07. MUJERES -->
            <!-- ===================================================== -->

            <section class="medical-card">

                <div class="section-header">
                    <div class="section-number">07</div>

                    <div>
                        <h2>En mujeres: estado de gravidez</h2>
                        <p>Información relacionada con embarazo y maternidad.</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-6">

                    <div class="habit-card">
                        <span>¿Está embarazada? *</span>

                        <div class="radio-group">
                            <label>
                                <input type="radio" asp-for="EstaEmbarazada" value="true" />
                                Sí
                            </label>

                            <label>
                                <input type="radio" asp-for="EstaEmbarazada" value="false" />
                                No
                            </label>
                        </div>
                    </div>


                    <div>
                        <label asp-for="NumeroHijos" class="field-label">
                            ¿Cuántos hijos tiene? *
                        </label>

                        <input asp-for="NumeroHijos"
                               type="number"
                               min="0"
                               max="30"
                               class="field-input"
                               placeholder="0" />

                        <span asp-validation-for="NumeroHijos" class="field-error"></span>
                    </div>

                </div>

            </section>


            <!-- ===================================================== -->
            <!-- 08. DIAGNÓSTICO -->
            <!-- ===================================================== -->

            <section class="medical-card">

                <div class="section-header">
                    <div class="section-number">08</div>

                    <div>
                        <h2>Diagnóstico médico en rehabilitación</h2>
                        <p>Evaluación neurológica y clínica inicial.</p>
                    </div>
                </div>

                <div class="mt-6">

                    <label asp-for="DiagnosticoMedicoRehabilitacion"
                           class="field-label">
                        Diagnóstico médico en rehabilitación *
                    </label>

                    <textarea asp-for="DiagnosticoMedicoRehabilitacion"
                              rows="4"
                              class="field-input"
                              placeholder="Diagnóstico médico..."></textarea>

                    <span asp-validation-for="DiagnosticoMedicoRehabilitacion"
                          class="field-error"></span>

                </div>


                <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-5">

                    <div>
                        <label asp-for="Reflejos" class="field-label">
                            Reflejos *
                        </label>


@{
    ViewData["Title"] = "FisioSport | Fisioterapia y Rehabilitación";
}

<!-- =========================================================
     FISIOSPORT - LANDING PAGE
     ========================================================= -->

<style>
    :root {
        --fs-bg: #0a101d;
        --fs-bg-soft: #0d1117;
        --fs-card: rgba(18, 28, 43, 0.78);
        --fs-card-light: rgba(255, 255, 255, 0.04);
        --fs-cyan: #00f0ff;
        --fs-cyan-soft: rgba(0, 240, 255, 0.14);
        --fs-text: #f5f9ff;
        --fs-muted: #9baabd;
        --fs-border: rgba(255, 255, 255, 0.09);
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        background: var(--fs-bg);
        color: var(--fs-text);
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .fs-navbar {
        background: rgba(10, 16, 29, 0.82);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    }

    .fs-brand {
        font-size: 1.45rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        color: #fff;
        text-decoration: none;
    }

        .fs-brand span {
            color: var(--fs-cyan);
        }

    .fs-nav-link {
        color: #b9c5d5 !important;
        font-weight: 500;
        transition: 0.25s ease;
    }

        .fs-nav-link:hover {
            color: var(--fs-cyan) !important;
        }

    .btn-fs-primary {
        background: var(--fs-cyan);
        color: #061018;
        border: 1px solid var(--fs-cyan);
        font-weight: 700;
        border-radius: 12px;
        padding: 11px 20px;
        box-shadow: 0 0 25px rgba(0, 240, 255, 0.12);
        transition: 0.25s ease;
    }

        .btn-fs-primary:hover {
            color: #061018;
            transform: translateY(-2px);
            box-shadow: 0 0 30px rgba(0, 240, 255, 0.25);
        }

    .btn-fs-outline {
        background: rgba(255,255,255,0.03);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.14);
        font-weight: 600;
        border-radius: 12px;
        padding: 11px 20px;
        transition: 0.25s ease;
    }

        .btn-fs-outline:hover {
            color: var(--fs-cyan);
            border-color: rgba(0,240,255,0.5);
            transform: translateY(-2px);
        }

    /* HERO */

    .fs-hero {
        position: relative;
        min-height: 760px;
        display: flex;
        align-items: center;
        overflow: hidden;
        background: radial-gradient(circle at 75% 25%, rgba(0,240,255,0.10), transparent 30%), radial-gradient(circle at 10% 70%, rgba(0,140,255,0.08), transparent 30%), var(--fs-bg);
    }

        .fs-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
            background-size: 50px 50px;
            mask-image: linear-gradient(to bottom, black, transparent);
            pointer-events: none;
        }

    .fs-hero-content {
        position: relative;
        z-index: 2;
    }

    .fs-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 999px;
        background: var(--fs-cyan-soft);
        border: 1px solid rgba(0,240,255,0.22);
        color: var(--fs-cyan);
        font-size: 0.82rem;
        font-weight: 700;
        margin-bottom: 22px;
    }

        .fs-badge i {
            font-size: 0.9rem;
        }

    .fs-hero h1 {
        font-size: clamp(2.8rem, 6vw, 5.2rem);
        line-height: 1.02;
        letter-spacing: -3px;
        font-weight: 800;
        max-width: 760px;
        margin-bottom: 25px;
    }

        .fs-hero h1 span {
            color: var(--fs-cyan);
        }

    .fs-hero-description {
        color: var(--fs-muted);
        font-size: 1.1rem;
        line-height: 1.8;
        max-width: 650px;
        margin-bottom: 32px;
    }

    .fs-hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 45px;
    }

    .fs-trust {
        display: flex;
        flex-wrap: wrap;
        gap: 25px;
    }

    .fs-trust-item {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #c8d2df;
        font-size: 0.9rem;
    }

        .fs-trust-item i {
            color: var(--fs-cyan);
            font-size: 1.15rem;
        }

    /* HERO IMAGE CARD */

    .fs-hero-visual {
        position: relative;
        z-index: 2;
    }

    .fs-image-card {
        position: relative;
        overflow: hidden;
        border-radius: 28px;
        border: 1px solid rgba(255,255,255,0.13);
        box-shadow: 0 30px 80px rgba(0,0,0,0.4);
        min-height: 540px;
    }

        .fs-image-card img {
            width: 100%;
            height: 540px;
            object-fit: cover;
            display: block;
        }

    .fs-image-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(5,10,18,0.92), rgba(5,10,18,0.05) 65%);
    }

    .fs-floating-card {
        position: absolute;
        left: 24px;
        right: 24px;
        bottom: 24px;
        padding: 18px;
        border-radius: 18px;
        background: rgba(8,15,27,0.75);
        border: 1px solid rgba(255,255,255,0.12);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
    }

    .fs-floating-card-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 700;
        margin-bottom: 5px;
    }

        .fs-floating-card-title i {
            color: var(--fs-cyan);
        }

    .fs-floating-card p {
        color: var(--fs-muted);
        font-size: 0.88rem;
        margin: 0;
    }

    /* BENEFITS */

    .fs-benefits {
        position: relative;
        z-index: 5;
        margin-top: -55px;
    }

    .fs-benefit-card {
        height: 100%;
        padding: 25px;
        border-radius: 18px;
        background: rgba(17,27,42,0.9);
        border: 1px solid var(--fs-border);
        backdrop-filter: blur(14px);
        transition: 0.3s ease;
    }

        .fs-benefit-card:hover {
            transform: translateY(-5px);
            border-color: rgba(0,240,255,0.35);
            box-shadow: 0 15px 40px rgba(0,0,0,0.2);
        }

    .fs-benefit-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: var(--fs-cyan-soft);
        color: var(--fs-cyan);
        font-size: 1.35rem;
        margin-bottom: 17px;
    }

    .fs-benefit-card h5 {
        font-weight: 700;
        margin-bottom: 7px;
    }

    .fs-benefit-card p {
        color: var(--fs-muted);
        margin: 0;
        font-size: 0.9rem;
        line-height: 1.6;
    }

    /* SECTIONS */

    .fs-section {
        padding: 110px 0;
    }

    .fs-section-soft {
        background: #0d1117;
    }

    .fs-section-header {
        max-width: 720px;
        margin: 0 auto 55px;
        text-align: center;
    }

    .fs-section-label {
        color: var(--fs-cyan);
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 0.75rem;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .fs-section-header h2 {
        font-size: clamp(2rem, 4vw, 3.2rem);
        font-weight: 800;
        letter-spacing: -1.5px;
        margin-bottom: 15px;
    }

    .fs-section-header p {
        color: var(--fs-muted);
        line-height: 1.8;
        margin: 0;
    }

    /* SPECIALISTS */

    .fs-specialist-card {
        height: 100%;
        overflow: hidden;
        border-radius: 22px;
        background: var(--fs-card);
        border: 1px solid var(--fs-border);
        transition: 0.3s ease;
    }

        .fs-specialist-card:hover {
            transform: translateY(-7px);
            border-color: rgba(0,240,255,0.35);
            box-shadow: 0 20px 50px rgba(0,0,0,0.3);
        }

    .fs-specialist-photo {
        position: relative;
        height: 330px;
        overflow: hidden;
    }

        .fs-specialist-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

    .fs-specialist-card:hover .fs-specialist-photo img {
        transform: scale(1.04);
    }

    .fs-specialist-photo::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(8,14,24,0.7), transparent 50%);
    }

    .fs-specialist-body {
        padding: 23px;
    }

        .fs-specialist-body h4 {
            font-weight: 750;
            margin-bottom: 6px;
        }

    .fs-specialty {
        color: var(--fs-cyan);
        font-size: 0.88rem;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .fs-license {
        color: #7f8da0;
        font-size: 0.82rem;
        margin-bottom: 18px;
    }

    .fs-whatsapp {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        padding: 11px;
        border-radius: 11px;
        color: #fff;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        text-decoration: none;
        font-weight: 650;
        transition: 0.25s ease;
    }

        .fs-whatsapp:hover {
            color: #fff;
            background: rgba(0,240,255,0.10);
            border-color: rgba(0,240,255,0.35);
        }

    /* SERVICES */

    .fs-service-card {
        position: relative;
        min-height: 340px;
        overflow: hidden;
        border-radius: 22px;
        border: 1px solid var(--fs-border);
        background: #111a29;
        transition: 0.35s ease;
    }

        .fs-service-card img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.55s ease;
        }

        .fs-service-card:hover img {
            transform: scale(1.06);
        }

    .fs-service-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient( to top, rgba(5,10,18,0.96), rgba(5,10,18,0.25) 70% );
    }

    .fs-service-content {
        position: absolute;
        left: 24px;
        right: 24px;
        bottom: 22px;
    }

    .fs-service-icon {
        width: 45px;
        height: 45px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--fs-cyan);
        background: rgba(0,240,255,0.12);
        border: 1px solid rgba(0,240,255,0.2);
        margin-bottom: 14px;
    }

    .fs-service-content h4 {
        font-weight: 750;
        margin-bottom: 7px;
    }

    .fs-service-content p {
        color: #aeb9c8;
        font-size: 0.88rem;
        line-height: 1.6;
        margin: 0;
    }

    /* TECHNOLOGY STRIP */

    .fs-tech-box {
        padding: 38px;
        border-radius: 24px;
        border: 1px solid rgba(0,240,255,0.16);
        background: radial-gradient(circle at right top, rgba(0,240,255,0.08), transparent 35%), rgba(255,255,255,0.025);
    }

    .fs-tech-item {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 15px 0;
        border-bottom: 1px solid rgba(255,255,255,0.07);
    }

        .fs-tech-item:last-child {
            border-bottom: none;
        }

        .fs-tech-item i {
            color: var(--fs-cyan);
            font-size: 1.2rem;
        }

        .fs-tech-item span {
            color: #c7d1de;
        }

    /* CONTACT */

    .fs-contact-card {
        height: 100%;
        padding: 34px;
        border-radius: 24px;
        background: rgba(255,255,255,0.035);
        border: 1px solid var(--fs-border);
    }

    .fs-contact-item {
        display: flex;
        gap: 15px;
        margin-bottom: 25px;
    }

    .fs-contact-icon {
        flex: 0 0 44px;
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: var(--fs-cyan-soft);
        color: var(--fs-cyan);
    }

    .fs-contact-item strong {
        display: block;
        margin-bottom: 4px;
    }

    .fs-contact-item span {
        color: var(--fs-muted);
        font-size: 0.9rem;
    }

    .fs-map {
        min-height: 470px;
        height: 100%;
        overflow: hidden;
        border-radius: 24px;
        border: 1px solid var(--fs-border);
        background: #111a29;
    }

        .fs-map iframe {
            width: 100%;
            height: 100%;
            min-height: 470px;
            border: 0;
            filter: grayscale(0.2) contrast(1.05);
        }

    /* FINAL CTA */

    .fs-final-cta {
        padding: 80px 0;
        background: radial-gradient(circle at center, rgba(0,240,255,0.11), transparent 50%), #0a101d;
    }

    .fs-final-box {
        padding: 55px 35px;
        text-align: center;
        border-radius: 28px;
        border: 1px solid rgba(0,240,255,0.16);
        background: rgba(255,255,255,0.025);
    }

        .fs-final-box h2 {
            font-weight: 800;
            font-size: clamp(2rem, 4vw, 3rem);
            margin-bottom: 14px;
        }

        .fs-final-box p {
            color: var(--fs-muted);
            max-width: 650px;
            margin: 0 auto 27px;
        }

    /* FOOTER */

    .fs-footer {
        padding: 35px 0;
        border-top: 1px solid rgba(255,255,255,0.07);
        background: #080d16;
    }

    .fs-footer-text {
        color: #718096;
        font-size: 0.85rem;
        margin: 0;
    }

    @@media (max-width: 991px) {
        .fs-hero {
            padding: 100px 0 80px;
        }

        .fs-image-card {
            margin-top: 45px;
        }

        .fs-benefits {
            margin-top: 0;
            padding-top: 35px;
        }
    }

    @@media (max-width: 576px) {
        .fs-section {
            padding: 75px 0;
        }

        .fs-hero h1 {
            letter-spacing: -1.8px;
        }

        .fs-image-card,
        .fs-image-card img {
            min-height: 420px;
            height: 420px;
        }

        .fs-trust {
            flex-direction: column;
            gap: 12px;
        }
    }
</style>

<!-- =========================================================
     NAVBAR
     ========================================================= -->

<nav class="navbar navbar-expand-lg fixed-top fs-navbar">
    <div class="container py-2">

        <a class="fs-brand" asp-controller="Home" asp-action="Index">
            Fisio<span>Sport</span>
        </a>

        <button class="navbar-toggler border-0 shadow-none"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#fsNavbar">
            <i class="bi bi-list text-white fs-2"></i>
        </button>

        <div class="collapse navbar-collapse" id="fsNavbar">

            <ul class="navbar-nav mx-auto gap-lg-2">

                <li class="nav-item">
                    <a class="nav-link fs-nav-link" href="#inicio">
                        Inicio
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link fs-nav-link" href="#especialistas">
                        Especialistas
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link fs-nav-link" href="#servicios">
                        Servicios
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link fs-nav-link" href="#contacto">
                        Contacto
                    </a>
                </li>

            </ul>

            <a class="btn btn-fs-primary"
               asp-controller="Account"
               asp-action="Login">
                <i class="bi bi-box-arrow-in-right me-1"></i>
                Iniciar Sesión
            </a>

        </div>
    </div>
</nav>


<!-- =========================================================
     HERO
     ========================================================= -->

<section id="inicio" class="fs-hero">

    <div class="container position-relative">

        <div class="row align-items-center g-5">

            <div class="col-lg-6">

                <div class="fs-hero-content">

                    <div class="fs-badge">
                        <i class="bi bi-shield-check"></i>
                        Fisioterapia y rehabilitación especializada
                    </div>

                    <h1>
                        Recupera tu
                        <span>movimiento.</span>
                        Recupera tu vida.
                    </h1>

                    <p class="fs-hero-description">
                        Tratamientos personalizados, seguimiento clínico
                        y rehabilitación física orientada a tus objetivos,
                        con un enfoque profesional y humano.
                    </p>

                    <div class="fs-hero-actions">

                        <a href="#especialistas"
                           class="btn btn-fs-primary btn-lg">
                            <i class="bi bi-calendar2-check me-2"></i>
                            Agendar Cita
                        </a>

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="btn btn-fs-outline btn-lg">
                            <i class="bi bi-person-circle me-2"></i>
                            Iniciar Sesión
                        </a>

                    </div>

                    <div class="fs-trust">

                        <div class="fs-trust-item">
                            <i class="bi bi-patch-check-fill"></i>
                            <span>Evaluación especializada</span>
                        </div>

                        <div class="fs-trust-item">
                            <i class="bi bi-clipboard2-pulse"></i>
                            <span>Seguimiento clínico</span>
                        </div>

                        <div class="fs-trust-item">
                            <i class="bi bi-heart-pulse-fill"></i>
                            <span>Atención personalizada</span>
                        </div>

                    </div>

                </div>

            </div>


            <div class="col-lg-6">

                <div class="fs-hero-visual">

                    <div class="fs-image-card">

                        <img src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=1200&q=85"
                             alt="Profesional de fisioterapia atendiendo a un paciente">

                        <div class="fs-image-overlay"></div>

                        <div class="fs-floating-card">

                            <div class="fs-floating-card-title">
                                <i class="bi bi-activity"></i>
                                Rehabilitación basada en objetivos
                            </div>

                            <p>
                                Evaluamos tu evolución y adaptamos el
                                tratamiento a cada etapa de tu recuperación.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     BENEFICIOS
     ========================================================= -->

<section class="fs-benefits">

    <div class="container">

        <div class="row g-3">

            <div class="col-md-4">

                <div class="fs-benefit-card">

                    <div class="fs-benefit-icon">
                        <i class="bi bi-person-badge"></i>
                    </div>

                    <h5>Evaluación Especializada</h5>

                    <p>
                        Valoración individual para conocer tus necesidades
                        y objetivos de recuperación.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="fs-benefit-card">

                    <div class="fs-benefit-icon">
                        <i class="bi bi-clipboard2-heart"></i>
                    </div>

                    <h5>Tratamientos Personalizados</h5>

                    <p>
                        Planes de rehabilitación adaptados a tu evolución
                        y características particulares.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="fs-benefit-card">

                    <div class="fs-benefit-icon">
                        <i class="bi bi-cpu"></i>
                    </div>

                    <h5>Equipamiento Moderno</h5>

                    <p>
                        Espacios y recursos orientados a una rehabilitación
                        funcional y progresiva.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     ESPECIALISTAS
     ========================================================= -->


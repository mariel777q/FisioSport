@{
    ViewData["Title"] = "FisioSport | Centro de Fisioterapia";
}

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center min-vh-75">

            <div class="col-lg-6">
                <span class="hero-badge">
                    Fisioterapia y rehabilitación integral
                </span>

                <h1 class="hero-title">
                    Recupera tu movimiento,
                    <span>recupera tu bienestar.</span>
                </h1>

                <p class="hero-text">
                    En FisioSport te acompañamos durante todo tu proceso
                    de recuperación con tratamientos personalizados,
                    tecnología y profesionales especializados.
                </p>

                <div class="hero-buttons">
                    <a href="/Account/Login" class="btn btn-primary btn-lg">
                        Iniciar Sesión
                    </a>

                    <a href="#contacto" class="btn btn-outline-light btn-lg">
                        Solicitar información
                    </a>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="hero-card">
                    <div class="hero-icon">
                        <i class="bi bi-heart-pulse"></i>
                    </div>

                    <h3>Tu recuperación es nuestra prioridad</h3>

                    <p>
                        Tratamientos personalizados para mejorar tu movilidad,
                        reducir el dolor y recuperar tu calidad de vida.
                    </p>

                    <div class="hero-stats">
                        <div>
                            <strong>+10</strong>
                            <span>Especialistas</span>
                        </div>

                        <div>
                            <strong>+500</strong>
                            <span>Pacientes atendidos</span>
                        </div>

                        <div>
                            <strong>100%</strong>
                            <span>Atención personalizada</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<section id="nosotros" class="section-light">
    <div class="container">

        <div class="section-heading text-center">
            <span>CONÓCENOS</span>
            <h2>Un centro pensado para tu recuperación</h2>

            <p>
                FisioSport combina experiencia profesional, atención humana
                y herramientas modernas para ofrecer una rehabilitación
                segura y efectiva.
            </p>
        </div>

        <div class="row g-4 mt-4">

            <div class="col-md-4">
                <div class="info-card">
                    <div class="info-icon">
                        <i class="bi bi-person-heart"></i>
                    </div>

                    <h4>Atención personalizada</h4>

                    <p>
                        Cada paciente recibe un tratamiento adaptado a sus
                        necesidades, objetivos y evolución.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="info-card">
                    <div class="info-icon">
                        <i class="bi bi-activity"></i>
                    </div>

                    <h4>Rehabilitación integral</h4>

                    <p>
                        Trabajamos movilidad, fuerza, estabilidad, prevención
                        de lesiones y recuperación funcional.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="info-card">
                    <div class="info-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <h4>Profesionales especializados</h4>

                    <p>
                        Nuestro equipo te acompaña con seguimiento constante
                        durante todo el tratamiento.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

<section id="servicios" class="section-dark">
    <div class="container">

        <div class="section-heading text-center">
            <span>NUESTROS SERVICIOS</span>
            <h2>Tratamientos para diferentes necesidades</h2>

            <p>
                Diseñamos planes de rehabilitación según la condición,
                objetivos y evolución de cada paciente.
            </p>
        </div>

        <div class="row g-4 mt-4">

            <div class="col-md-4">
                <div class="service-card">
                    <i class="bi bi-person-walking"></i>
                    <h4>Rehabilitación deportiva</h4>
                    <p>
                        Recuperación de lesiones musculares, articulares
                        y deportivas.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="service-card">
                    <i class="bi bi-bandaid"></i>
                    <h4>Tratamiento del dolor</h4>
                    <p>
                        Evaluación y tratamiento de molestias musculares,
                        articulares y posturales.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="service-card">
                    <i class="bi bi-person-arms-up"></i>
                    <h4>Recuperación funcional</h4>
                    <p>
                        Ejercicios y terapias para recuperar fuerza,
                        movilidad y autonomía.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="service-card">
                    <i class="bi bi-heart-pulse"></i>
                    <h4>Fisioterapia preventiva</h4>
                    <p>
                        Prevención de lesiones y mantenimiento de una buena
                        condición física.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="service-card">
                    <i class="bi bi-person-check"></i>
                    <h4>Seguimiento personalizado</h4>
                    <p>
                        Control de evolución, sesiones completadas y objetivos
                        de rehabilitación.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="service-card">
                    <i class="bi bi-house-heart"></i>
                    <h4>Ejercicios para casa</h4>
                    <p>
                        Rutinas personalizadas para continuar el tratamiento
                        fuera del centro.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>


<section id="contacto" class="section-light">
    <div class="container">

        <div class="section-heading text-center">
            <span>ENCUÉNTRANOS</span>
            <h2>Visítanos en FisioSport</h2>

            <p>
                Agenda tu cita y comienza tu proceso de recuperación.
            </p>
        </div>

        <div class="row g-4 mt-4 align-items-stretch">

            <div class="col-lg-5">
                <div class="contact-card">

                    <h4>Información de contacto</h4>

                    <div class="contact-item">
                        <i class="bi bi-geo-alt"></i>
                        <div>
                            <strong>Dirección</strong>
                            <p>
                                Coloca aquí la dirección real del centro.
                            </p>
                        </div>
                    </div>

                    <div class="contact-item">
                        <i class="bi bi-telephone"></i>
                        <div>
                            <strong>Teléfono</strong>
                            <p>
                                +00 000 000 0000
                            </p>
                        </div>
                    </div>

                    <div class="contact-item">
                        <i class="bi bi-envelope"></i>
                        <div>
                            <strong>Correo</strong>
                            <p>
                                contacto@fisiosport.com
                            </p>
                        </div>
                    </div>

                    <a href="/Account/Login" class="btn btn-primary w-100 mt-3">
                        Iniciar Sesión
                    </a>

                </div>
            </div>

            <div class="col-lg-7">
                <div class="map-container">

                    <iframe src="https://www.google.com/maps?q=Coloca+Aqui+La+Direccion&output=embed"
                            width="100%"
                            height="100%"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade">
                    </iframe>

                </div>
            </div>

        </div>
    </div>

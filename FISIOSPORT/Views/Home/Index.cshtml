                        </a>

                    </div>

                </div>

            </div>


            <!-- ESPECIALISTA 2 -->

            <div class="col-md-6 col-lg-4">

                <div class="fs-specialist-card">

                    <div class="fs-specialist-photo">

                        <img src="https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&w=800&q=85"
                             alt="Profesional médico">

                    </div>

                    <div class="fs-specialist-body">

                        <h4>
                            Lic. Carlos Mendoza
                        </h4>

                        <div class="fs-specialty">
                            Rehabilitación Neurológica
                        </div>

                        <div class="fs-license">
                            Colegiado: COL-7789
                        </div>

                        <a href="https://wa.me/0000000000"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="fs-whatsapp">

                            <i class="bi bi-whatsapp"></i>
                            Contactar por WhatsApp

                        </a>

                    </div>

                </div>

            </div>


            <!-- ESPECIALISTA 3 -->


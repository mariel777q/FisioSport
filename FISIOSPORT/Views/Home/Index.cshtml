@{
    ViewData["Title"] = "FisioSport | Centro de Fisioterapia";
}

<style>
    :root {
        --fs-bg: #0a101d;
        --fs-bg-soft: #0d1524;
        --fs-card: rgba(17, 27, 43, 0.72);
        --fs-card-solid: #111b2b;
        --fs-border: rgba(255, 255, 255, 0.10);
        --fs-border-cyan: rgba(0, 240, 255, 0.28);
        --fs-cyan: #00f0ff;
        --fs-cyan-soft: rgba(0, 240, 255, 0.12);
        --fs-text: #f3f7fb;
        --fs-muted: #aab6c7;
        --fs-radius: 20px;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        background: var(--fs-bg);
        color: var(--fs-text);
        margin: 0;
        overflow-x: hidden;
    }

    /* =========================================================
           GENERAL
           ========================================================= */

    .fs-section {
        position: relative;
        padding: 72px 0;
    }

    .fs-section-dark {
        background: radial-gradient(circle at 15% 20%, rgba(0, 240, 255, 0.055), transparent 30%), var(--fs-bg);
    }

    .fs-section-soft {
        background: linear-gradient(180deg, #0d1524 0%, #0a101d 100%);
    }

    .fs-container {
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto;
    }

    .fs-section-heading {
        max-width: 760px;
        margin: 0 auto 42px;
        text-align: center;
    }

        .fs-section-heading span {
            display: inline-block;
            margin-bottom: 10px;
            color: var(--fs-cyan);
            font-size: 0.76rem;
            font-weight: 800;
            letter-spacing: 0.18em;
            text-transform: uppercase;
        }

        .fs-section-heading h2 {
            margin: 0;
            color: #ffffff;
            font-size: clamp(1.9rem, 3vw, 2.8rem);
            line-height: 1.12;
            font-weight: 800;
        }

        .fs-section-heading p {
            margin: 15px auto 0;
            max-width: 650px;
            color: var(--fs-muted);
            font-size: 1rem;
            line-height: 1.7;
        }

    .fs-glass {
        background: var(--fs-card);
        border: 1px solid var(--fs-border);
        border-radius: var(--fs-radius);
        box-shadow: 0 18px 50px rgba(0, 0, 0, 0.20);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
    }

    /* =========================================================
           HERO
           ========================================================= */

    .fs-hero {
        position: relative;
        padding: 58px 0 66px;
        background: radial-gradient(circle at 75% 35%, rgba(0, 240, 255, 0.12), transparent 28%), radial-gradient(circle at 15% 80%, rgba(0, 240, 255, 0.06), transparent 28%), var(--fs-bg);
        overflow: hidden;
    }

        .fs-hero::before {
            content: "";
            position: absolute;
            width: 420px;
            height: 420px;
            right: -180px;
            top: -180px;
            border-radius: 50%;
            background: rgba(0, 240, 255, 0.035);
            pointer-events: none;
        }

    .fs-hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(380px, 0.95fr);
        gap: 54px;
        align-items: center;
    }

    .fs-hero-content {
        max-width: 650px;
    }

    .fs-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border: 1px solid var(--fs-border-cyan);
        border-radius: 999px;
        background: rgba(0, 240, 255, 0.06);
        color: var(--fs-cyan);
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .fs-hero-title {
        margin: 18px 0 18px;
        font-size: clamp(2.4rem, 5vw, 4.6rem);
        font-weight: 900;
        line-height: 0.98;
        letter-spacing: -0.045em;
        color: #ffffff;
    }

        .fs-hero-title span {
            display: block;
            color: var(--fs-cyan);
        }

    .fs-hero-text {
        max-width: 600px;
        margin: 0;
        color: var(--fs-muted);
        font-size: clamp(0.98rem, 1.5vw, 1.1rem);
        line-height: 1.75;
    }

    .fs-hero-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
    }

    .fs-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 48px;
        padding: 11px 20px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 800;
        transition: 0.25s ease;
    }

    .fs-btn-primary {
        border: 1px solid var(--fs-cyan);
        background: var(--fs-cyan);
        color: #061017;
        box-shadow: 0 8px 25px rgba(0, 240, 255, 0.16);
    }

        .fs-btn-primary:hover {
            transform: translateY(-2px);
            color: #061017;
            box-shadow: 0 12px 32px rgba(0, 240, 255, 0.28);
        }

    .fs-btn-outline {
        border: 1px solid rgba(255, 255, 255, 0.18);
        background: rgba(255, 255, 255, 0.035);
        color: #ffffff;
    }

        .fs-btn-outline:hover {
            transform: translateY(-2px);
            border-color: var(--fs-cyan);
            color: var(--fs-cyan);
        }

    .fs-hero-visual {
        position: relative;
    }

    .fs-hero-image {
        position: relative;
        aspect-ratio: 16 / 11;
        min-height: 360px;
        overflow: hidden;
        border: 1px solid var(--fs-border-cyan);
        border-radius: 24px;
        background: #101a29;
        box-shadow: 0 25px 70px rgba(0, 0, 0, 0.30);
    }

        .fs-hero-image img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            object-position: center;
        }

    .fs-hero-overlay {
        position: absolute;
        inset: auto 16px 16px 16px;
        padding: 18px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 16px;
        background: rgba(5, 12, 22, 0.72);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

        .fs-hero-overlay strong {
            display: block;
            margin-bottom: 4px;
            color: #ffffff;
            font-size: 1rem;
        }

        .fs-hero-overlay span {
            color: #b9c6d5;
            font-size: 0.88rem;
        }

    .fs-hero-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin-top: 14px;
    }

    .fs-stat {
        padding: 13px 10px;
        text-align: center;
        border: 1px solid var(--fs-border);
        border-radius: 13px;
        background: rgba(255, 255, 255, 0.025);
    }

        .fs-stat strong {
            display: block;
            color: var(--fs-cyan);
            font-size: 1.2rem;
        }

        .fs-stat span {
            display: block;
            margin-top: 3px;
            color: var(--fs-muted);
            font-size: 0.7rem;
        }

    /* =========================================================
           BENEFITS
           ========================================================= */

    .fs-benefits {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .fs-info-card {
        height: 100%;
        padding: 25px;
        border: 1px solid var(--fs-border);
        border-radius: var(--fs-radius);
        background: rgba(17, 27, 43, 0.58);
        transition: 0.25s ease;
    }

        .fs-info-card:hover {
            transform: translateY(-4px);
            border-color: var(--fs-border-cyan);
            box-shadow: 0 18px 40px rgba(0, 0, 0, 0.20);
        }

    .fs-icon {
        width: 48px;
        height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
        border-radius: 14px;
        background: var(--fs-cyan-soft);
        color: var(--fs-cyan);
        font-size: 1.35rem;
    }

    .fs-info-card h3 {
        margin: 0 0 9px;
        color: #ffffff;
        font-size: 1.12rem;
        font-weight: 800;
    }

    .fs-info-card p {
        margin: 0;
        color: var(--fs-muted);
        line-height: 1.65;
        font-size: 0.92rem;
    }

    /* =========================================================
           SERVICES
           ========================================================= */

    .fs-service-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .fs-service-card {
        overflow: hidden;
        border: 1px solid var(--fs-border);
        border-radius: var(--fs-radius);
        background: var(--fs-card);
        transition: 0.28s ease;
    }

        .fs-service-card:hover {
            transform: translateY(-5px);
            border-color: var(--fs-border-cyan);
        }

    .fs-service-image {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: #111b2b;
    }

        .fs-service-image img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            transition: transform 0.35s ease;
        }

    .fs-service-card:hover .fs-service-image img {
        transform: scale(1.045);
    }

    .fs-service-content {
        padding: 20px;
    }

    .fs-service-icon {
        width: 40px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
        border-radius: 11px;
        background: var(--fs-cyan-soft);
        color: var(--fs-cyan);
    }

    .fs-service-content h3 {
        margin: 0 0 7px;
        color: #ffffff;
        font-size: 1.08rem;
        font-weight: 800;
    }

    .fs-service-content p {
        margin: 0;
        color: var(--fs-muted);
        font-size: 0.9rem;
        line-height: 1.6;
    }

    /* =========================================================
           INSTALACIONES
           ========================================================= */

    .fs-facility-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .fs-facility-card {
        height: 100%;
        padding: 24px;
        border: 1px solid var(--fs-border);
        border-radius: var(--fs-radius);
        background: rgba(17, 27, 43, 0.62);
    }

    .fs-facility-image {
        aspect-ratio: 16 / 9;
        overflow: hidden;
        margin-bottom: 18px;
        border-radius: 15px;
        background: #101a29;
    }

        .fs-facility-image img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
        }

    .fs-facility-card h3 {
        margin: 0 0 8px;
        color: #ffffff;
        font-size: 1.1rem;
    }

    .fs-facility-card p {
        margin: 0;
        color: var(--fs-muted);
        line-height: 1.6;
        font-size: 0.9rem;
    }

    /* =========================================================
           SPECIALISTS
           ========================================================= */

    .fs-specialists {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .fs-specialist-card {
        height: 100%;
        overflow: hidden;
        border: 1px solid var(--fs-border);
        border-radius: var(--fs-radius);
        background: rgba(17, 27, 43, 0.72);
        transition: 0.28s ease;
    }

        .fs-specialist-card:hover {
            transform: translateY(-5px);
            border-color: var(--fs-border-cyan);
            box-shadow: 0 22px 48px rgba(0, 0, 0, 0.24);
        }

    .fs-specialist-photo {
        position: relative;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        background: #101a29;
    }

        .fs-specialist-photo img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            object-position: center top;
        }

    .fs-specialist-content {
        display: flex;
        min-height: 245px;
        flex-direction: column;
        padding: 21px;
    }

        .fs-specialist-content h3 {
            margin: 0 0 6px;
            color: #ffffff;
            font-size: 1.2rem;
            font-weight: 800;
        }

    .fs-specialty {
        margin: 0 0 12px;
        color: var(--fs-cyan);
        font-size: 0.85rem;
        font-weight: 700;
    }

    .fs-specialist-content p.description {
        margin: 0;
        color: var(--fs-muted);
        font-size: 0.9rem;
        line-height: 1.6;
    }

    .fs-collegiado {
        margin-top: 12px;
        color: #dce5ef;
        font-size: 0.8rem;
    }

    .fs-whatsapp {
        width: 100%;
        margin-top: auto;
        padding-top: 17px;
    }

        .fs-whatsapp a {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            min-height: 44px;
            border: 1px solid rgba(255, 255, 255, 0.13);
            border-radius: 11px;
            background: rgba(255, 255, 255, 0.035);
            color: #ffffff;
            text-decoration: none;
            font-size: 0.86rem;
            font-weight: 800;
            transition: 0.25s ease;
        }

            .fs-whatsapp a:hover {
                border-color: rgba(0, 240, 255, 0.35);
                background: var(--fs-cyan-soft);
                color: var(--fs-cyan);
            }

    /* =========================================================
           CONTACT
           ========================================================= */

    .fs-contact-grid {
        display: grid;
        grid-template-columns: minmax(300px, 0.82fr) minmax(0, 1.18fr);
        gap: 20px;
        align-items: stretch;
    }

    .fs-contact-card {
        height: 100%;
        padding: 27px;
        border: 1px solid var(--fs-border);
        border-radius: var(--fs-radius);
        background: rgba(17, 27, 43, 0.68);
    }

        .fs-contact-card h3 {
            margin: 0 0 24px;
            color: #ffffff;
            font-size: 1.25rem;
        }

    .fs-contact-item {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        padding: 13px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

        .fs-contact-item:last-of-type {
            border-bottom: 0;
        }

        .fs-contact-item i {
            flex: 0 0 auto;
            width: 38px;
            height: 38px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: var(--fs-cyan-soft);
            color: var(--fs-cyan);
        }

        .fs-contact-item strong {
            display: block;
            margin-bottom: 3px;
            color: #ffffff;
            font-size: 0.88rem;
        }

        .fs-contact-item p {
            margin: 0;
            color: var(--fs-muted);
            font-size: 0.86rem;
            line-height: 1.5;
        }

    .fs-login-contact {
        margin-top: 20px;
    }

    .fs-map {
        min-height: 420px;
        overflow: hidden;
        border: 1px solid var(--fs-border);
        border-radius: var(--fs-radius);
        background: #111b2b;
    }

        .fs-map iframe {
            width: 100%;
            height: 100%;
            min-height: 420px;
            display: block;
            border: 0;
        }

    /* =========================================================
           FINAL CTA
           ========================================================= */

    .fs-final-cta {
        padding: 60px 0;
        background: radial-gradient(circle at center, rgba(0, 240, 255, 0.10), transparent 48%), var(--fs-bg);
    }

    .fs-cta-box {
        position: relative;
        overflow: hidden;
        padding: 48px 35px;
        text-align: center;
        border: 1px solid var(--fs-border-cyan);
        border-radius: 24px;
        background: linear-gradient(135deg, rgba(0, 240, 255, 0.07), rgba(17, 27, 43, 0.76));
    }

        .fs-cta-box h2 {
            margin: 0;
            color: #ffffff;
            font-size: clamp(1.8rem, 4vw, 2.8rem);
            font-weight: 900;
        }

        .fs-cta-box p {
            max-width: 650px;
            margin: 13px auto 25px;
            color: var(--fs-muted);
            line-height: 1.7;
        }

    .fs-cta-buttons {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    /* =========================================================
           FOOTER
           ========================================================= */

    .fs-footer {
        padding: 26px 0;
        border-top: 1px solid rgba(255, 255, 255, 0.07);
        background: #070c15;
    }

    .fs-footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .fs-footer-brand {
        color: #ffffff;
        font-weight: 900;
        text-decoration: none;
    }

        .fs-footer-brand span {
            color: var(--fs-cyan);
        }

    .fs-footer p {
        margin: 0;
        color: #748195;
        font-size: 0.8rem;
    }

    /* =========================================================
           RESPONSIVE - LAPTOP
           ========================================================= */

    @@media (max-width: 1100px) {

        .fs-container {
            width: min(100% - 32px, 1000px);
        }

        .fs-hero-grid {
            grid-template-columns: 1fr 0.9fr;
            gap: 32px;
        }

        .fs-hero-title {
            font-size: clamp(2.35rem, 5vw, 3.7rem);
        }

        .fs-service-grid,
        .fs-specialists,
        .fs-facility-grid {
            gap: 15px;
        }
    }

    /* =========================================================
           RESPONSIVE - TABLET
           ========================================================= */

    @@media (max-width: 991px) {

        .fs-section {
            padding: 58px 0;
        }

        .fs-hero {
            padding: 45px 0 55px;
        }

        .fs-hero-grid {
            grid-template-columns: 1fr;
            gap: 30px;
        }

        .fs-hero-content {
            max-width: 760px;
            margin: 0 auto;
            text-align: center;
        }

        .fs-hero-text {
            margin-left: auto;
            margin-right: auto;
        }

        .fs-hero-buttons {
            justify-content: center;
        }

        .fs-hero-visual {
            width: min(720px, 100%);
            margin: 0 auto;
        }

        .fs-hero-image {
            min-height: 0;
        }

        .fs-benefits,
        .fs-service-grid,
        .fs-facility-grid,
        .fs-specialists {
            grid-template-columns: repeat(2, 1fr);
        }

        .fs-contact-grid {
            grid-template-columns: 1fr;
        }

        .fs-map,
        .fs-map iframe {
            min-height: 360px;
        }
    }

    /* =========================================================
           RESPONSIVE - MOBILE GRANDE
           ========================================================= */

    @@media (max-width: 767px) {

        .fs-container {
            width: min(100% - 26px, 620px);
        }

        .fs-section {
            padding: 48px 0;
        }

        .fs-section-heading {
            margin-bottom: 30px;
        }

            .fs-section-heading h2 {
                font-size: 1.9rem;
            }

            .fs-section-heading p {
                font-size: 0.9rem;
            }

        .fs-hero {
            padding: 32px 0 45px;
        }

        .fs-hero-title {
            margin-top: 15px;
            font-size: clamp(2.25rem, 11vw, 3.2rem);
        }

        .fs-hero-text {
            font-size: 0.94rem;
            line-height: 1.65;
        }

        .fs-hero-buttons {
            margin-top: 22px;
        }

        .fs-btn {
            min-height: 46px;
            padding: 10px 17px;
            font-size: 0.86rem;
        }

        .fs-hero-stats {
            gap: 7px;
        }

        .fs-stat {
            padding: 11px 6px;
        }

            .fs-stat strong {
                font-size: 1rem;
            }

            .fs-stat span {
                font-size: 0.62rem;
            }

        .fs-benefits,
        .fs-service-grid,
        .fs-facility-grid,
        .fs-specialists {
            grid-template-columns: 1fr;
        }

        .fs-specialist-content {
            min-height: auto;
        }

        .fs-map,
        .fs-map iframe {
            min-height: 320px;
        }

        .fs-cta-box {
            padding: 35px 20px;
        }

        .fs-footer-inner {
            flex-direction: column;
            text-align: center;
        }
    }

    /* =========================================================
           RESPONSIVE - MOBILE PEQUEÑO
           ========================================================= */

    @@media (max-width: 575px) {

        .fs-container {
            width: calc(100% - 22px);
        }

        .fs-hero-title {
            font-size: 2.25rem;
        }

        .fs-hero-buttons {
            flex-direction: column;
            width: 100%;
        }

        .fs-btn {
            width: 100%;
        }

        .fs-hero-image {
            aspect-ratio: 4 / 3;
            border-radius: 18px;
        }

        .fs-hero-overlay {
            left: 10px;
            right: 10px;
            bottom: 10px;
            padding: 13px;
        }

            .fs-hero-overlay strong {
                font-size: 0.88rem;
            }

            .fs-hero-overlay span {
                font-size: 0.76rem;
            }

        .fs-contact-card {
            padding: 21px;
        }

        .fs-contact-item {
            gap: 10px;
        }

        .fs-map,
        .fs-map iframe {
            min-height: 280px;
        }

        .fs-final-cta {
            padding: 45px 0;
        }

        .fs-cta-buttons {
            flex-direction: column;
        }

            .fs-cta-buttons .fs-btn {
                width: 100%;
            }
    }
</style>


<!-- =========================================================
     HERO
     ========================================================= -->

<section class="fs-hero">

    <div class="fs-container">

        <div class="fs-hero-grid">

            <div class="fs-hero-content">

                <span class="fs-hero-badge">
                    <i class="bi bi-heart-pulse"></i>
                    Fisioterapia y rehabilitación integral
                </span>

                <h1 class="fs-hero-title">
                    Recupera tu movimiento,
                    <span>recupera tu bienestar.</span>
                </h1>

                <p class="fs-hero-text">
                    En FisioSport te acompañamos durante todo tu proceso
                    de recuperación con tratamientos personalizados,
                    tecnología y profesionales especializados.
                </p>

                <div class="fs-hero-buttons">

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="fs-btn fs-btn-primary">

                        <i class="bi bi-box-arrow-in-right"></i>
                        Iniciar Sesión

                    </a>

                    <a href="#especialistas"
                       class="fs-btn fs-btn-outline">

                        <i class="bi bi-calendar2-check"></i>
                        Agendar Cita

                    </a>

                </div>

            </div>


            <div class="fs-hero-visual">

                <div class="fs-hero-image">

                    <img src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=1200&q=85"
                         alt="Atención profesional de fisioterapia"
                         loading="eager" />

                    <div class="fs-hero-overlay">

                        <strong>

@model FISIOSPORT.Models.DashboardPacienteViewModel

@{
    ViewData["Title"] = "Mi Dashboard";
}

<div class="mb-8">

    <p class="text-xs font-bold uppercase tracking-[0.2em] text-cyan-400">
        FISIOSPORT
    </p>

    <h2 class="mt-2 text-3xl font-extrabold text-white">
        Bienvenido, @Model.Nombre
    </h2>

    <p class="text-gray-400 text-sm mt-2">
        Estos son tus ejercicios y próximas sesiones.
    </p>

</div>

<!-- ============================================================= -->
<!-- EJERCICIOS DEL DÍA -->
<!-- ============================================================= -->

<section class="mb-10">

    <div class="mb-5">

        <h2 class="text-xl font-extrabold text-white">
            Tus ejercicios del día
        </h2>

        <p class="text-sm text-gray-500 mt-1">
            Realiza los ejercicios indicados por tu fisioterapeuta.
        </p>

    </div>

    @if (!Model.EjerciciosPendientes.Any())
    {
        <div class="rounded-2xl border border-emerald-400/20 bg-emerald-400/5 p-10 text-center">

            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-emerald-400/10 text-emerald-400 text-2xl">
                ✓
            </div>

            <h3 class="mt-5 text-xl font-extrabold text-emerald-300">
                SIN EJERCICIOS PENDIENTES
            </h3>

            <p class="mt-2 text-sm text-gray-500">
                Has completado todos los ejercicios asignados.
            </p>

        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">

            @foreach (var ejercicio in Model.EjerciciosPendientes)
            {
                <article class="overflow-hidden rounded-2xl border border-gray-800 bg-[#161b22]">

                    <div class="h-56 w-full bg-[#0d1117]">

                        @if (!string.IsNullOrWhiteSpace(
                            ejercicio.ImagenUrl))
                        {
                            <img src="@ejercicio.ImagenUrl"
                                 alt="@ejercicio.Nombre"
                                 class="h-full w-full object-cover"
                                 loading="lazy" />
                        }
                        else
                        {
                            <div class="flex h-full items-center justify-center text-cyan-400 font-bold">
                                @ejercicio.Nombre
                            </div>
                        }

                    </div>

                    <div class="p-6">

                        <div class="flex flex-wrap gap-2">

                            <span class="rounded-full border border-cyan-400/20 bg-cyan-400/5 px-2.5 py-1 text-[10px] font-bold text-cyan-300">
                                @ejercicio.RegionAnatomica
                            </span>

                            <span class="rounded-full border border-purple-400/20 bg-purple-400/5 px-2.5 py-1 text-[10px] font-bold text-purple-300">
                                @ejercicio.ObjetivoTerapeutico
                            </span>

                        </div>

                        <h3 class="mt-4 text-xl font-extrabold text-white">
                            @ejercicio.Nombre
                        </h3>

                        <p class="mt-2 text-sm leading-6 text-gray-400">
                            @ejercicio.Descripcion
                        </p>

                        <div class="mt-5 rounded-xl border border-gray-800 bg-[#0d1117] p-4">

                            <div class="grid grid-cols-2 gap-4 text-center">

                                <div>

                                    <p class="text-2xl font-extrabold text-cyan-400">
                                        @ejercicio.Series
                                    </p>

                                    <p class="text-xs text-gray-500">
                                        Series
                                    </p>

                                </div>

                                <div>

                                    <p class="text-2xl font-extrabold text-cyan-400">
                                        @ejercicio.Repeticiones
                                    </p>

                                    <p class="text-xs text-gray-500">
                                        Repeticiones
                                    </p>

                                </div>

                            </div>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(
                            ejercicio.Instrucciones))
                        {
                            <div class="mt-5">

                                <p class="text-xs font-bold uppercase tracking-wider text-gray-500">
                                    Indicaciones
                                </p>

                                <p class="mt-2 text-sm leading-6 text-gray-300">
                                    @ejercicio.Instrucciones
                                </p>

                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(
                            ejercicio.VideoUrl))
                        {
                            <a href="@ejercicio.VideoUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="mt-5 block text-center text-sm font-bold text-cyan-400 hover:text-cyan-300">

                                ▶ Ver cómo realizar el ejercicio

                            </a>
                        }

                        <form asp-controller="EjerciciosPaciente"
                              asp-action="Completar"
                              method="post"
                              class="mt-5">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@ejercicio.AsignacionId" />

                            <button type="submit"
                                    class="w-full rounded-xl bg-emerald-400 px-5 py-3.5 font-extrabold text-[#071017] hover:bg-emerald-300 transition">

                                COMPLETAR

                            </button>

                        </form>

                    </div>

                </article>
            }

        </div>
    }

</section>

<!-- ============================================================= -->
<!-- CITAS -->
<!-- ============================================================= -->

<div class="mb-5">

    <h2 class="text-lg font-bold text-white">
        Mis próximas sesiones
    </h2>

</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">

    @if (!Model.Citas.Any())
    {
        <p class="text-gray-500 col-span-full">
            Aún no tienes citas agendadas.
        </p>
    }

    @foreach (var cita in Model.Citas)
    {
        <div class="rounded-xl border border-gray-800 bg-[#161b22] p-5">

            <h4 class="font-semibold text-gray-100">
                @cita.NombreFisioterapeuta
            </h4>

            <p class="text-sm text-cyan-400 mb-2">
                @cita.Especialidad
            </p>

            <p class="text-sm text-gray-400">
                @cita.Fecha.ToString("dd MMM yyyy")
                &middot;
                @cita.Hora
            </p>

            <span class="inline-block mt-2 text-[11px] px-2 py-0.5 rounded-full border bg-gray-400/10 text-gray-300 border-gray-400/30">
                @cita.Estado
            </span>

        </div>
    }

</div>

@if (TempData["MensajeEjercicio"] != null)
{
    <div class="fixed bottom-6 right-6 z-50 rounded-xl border border-emerald-400/30 bg-[#161b22] px-5 py-4 shadow-2xl">

        <p class="font-bold text-emerald-300">
            ✓ @TempData["MensajeEjercicio"]
        </p>

    </div>
}
@model FISIOSPORT.Models.DashboardPacienteViewModel
@{
    ViewData["Title"] = "Mi Dashboard";
}

<div class="mb-8">
    <h2 class="text-2xl font-extrabold text-white">Hola, @Model.Nombre</h2>
    <p class="text-gray-400 text-sm mt-1">Este es el resumen de tus próximas sesiones.</p>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
    @if (!Model.Citas.Any())
    {
        <p class="text-gray-500 col-span-full">Aún no tienes citas agendadas.</p>
    }
    @foreach (var cita in Model.Citas)
    {
        <div class="rounded-xl border border-gray-800 bg-[#161b22] p-5">
            <h4 class="font-semibold text-gray-100">@cita.NombreFisioterapeuta</h4>
            <p class="text-sm text-cyan-400 mb-2">@cita.Especialidad</p>
            <p class="text-sm text-gray-400">@cita.Fecha.ToString("dd MMM yyyy") &middot; @cita.Hora</p>
            <span class="inline-block mt-2 text-[11px] px-2 py-0.5 rounded-full border bg-gray-400/10 text-gray-300 border-gray-400/30">@cita.Estado</span>
        </div>
    }
</div>
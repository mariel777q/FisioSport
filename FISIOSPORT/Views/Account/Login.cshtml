@model FISIOSPORT.Models.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión - FisioSport</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
            body {
                font-family: 'Inter', sans-serif;
                background-color: #0d1117;
                background-image: radial-gradient(circle at 15% 50%, rgba(34,211,238,0.08), transparent 40%);
            }

            .glass {
                background: rgba(22, 27, 34, 0.55);
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px);
                border: 1px solid rgba(255,255,255,0.08);
            }

            .btn-glow {
                box-shadow: 0 0 15px rgba(34, 211, 238, 0.45), 0 0 2px rgba(34,211,238,0.8);
                transition: box-shadow 0.25s ease, transform 0.15s ease;
            }

                .btn-glow:hover {
                    box-shadow: 0 0 25px rgba(34, 211, 238, 0.7), 0 0 4px rgba(34,211,238,1);
                    transform: translateY(-1px);
                }
    </style>
</head>
<body class="min-h-screen w-full flex items-center justify-center overflow-hidden relative">

    <div class="hidden lg:flex absolute left-0 top-0 h-full w-1/3 items-center justify-center opacity-30 pointer-events-none">
        <svg viewBox="0 0 200 600" class="h-4/5 w-auto" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M100 10 C 80 40, 120 60, 100 90 C 80 120, 120 140, 100 170 C 80 200, 120 220, 100 250 C 80 280, 120 300, 100 330 C 80 360, 120 380, 100 410 C 80 440, 120 460, 100 490 C 85 515, 115 535, 100 560"
                  stroke="#9CA3AF" stroke-width="1.5" stroke-linecap="round" />
            @{
                var puntosVertebrales = new[] { 30, 70, 110, 150, 190, 230, 270, 310, 350, 390, 430, 470, 510 };
            }
            @foreach (var y in puntosVertebrales)
            {
                <ellipse cx="100" cy="@y" rx="26" ry="12" stroke="#9CA3AF" stroke-width="1" />
            }
        </svg>
    </div>

    <div class="relative z-10 w-full max-w-md mx-4">
        <div class="glass rounded-2xl p-8 shadow-2xl">
            <div class="text-center mb-8">
                <h1 class="text-2xl font-extrabold tracking-tight text-white">
                    FISIO<span class="text-cyan-400">SPORT</span>
                </h1>
                <p class="text-gray-400 text-sm mt-2">Centro de Rehabilitación &amp; Fisioterapia</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.MensajeError))
            {
                <div class="bg-red-500/10 border border-red-500/30 text-red-400 text-sm rounded-lg px-4 py-2 mb-4">
                    @Model.MensajeError
                </div>
            }

            <form asp-controller="Account" asp-action="Login" method="post" class="space-y-5">
                <div>
                    <label asp-for="Correo" class="block text-sm text-gray-300 mb-1">Correo electrónico</label>
                    <input asp-for="Correo" class="w-full bg-[#0d1117] border border-gray-700 rounded-lg px-4 py-2.5 text-gray-100 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-cyan-400/60 focus:border-cyan-400 transition" placeholder="tucorreo@fisiosport.com" />
                    <span asp-validation-for="Correo" class="text-red-400 text-xs"></span>
                </div>
                <div>
                    <label asp-for="Password" class="block text-sm text-gray-300 mb-1">Contraseña</label>
                    <input asp-for="Password" class="w-full bg-[#0d1117] border border-gray-700 rounded-lg px-4 py-2.5 text-gray-100 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-cyan-400/60 focus:border-cyan-400 transition" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-red-400 text-xs"></span>
                </div>

                <button type="submit" class="btn-glow w-full bg-cyan-400 text-[#0d1117] font-bold py-2.5 rounded-lg hover:bg-cyan-300 transition">
                    Ingresar
                </button>
            </form>

            <p class="text-center text-gray-500 text-xs mt-6">
                Acceso exclusivo para pacientes y fisioterapeutas registrados.
            </p>
        </div>
    </div>
</body>
</html>
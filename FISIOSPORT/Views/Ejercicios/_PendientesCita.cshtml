@model FISIOSPORT.Models.EjerciciosCitaViewModel

<div>

    <div class="flex items-start justify-between gap-3">

        <div>

            <p class="text-xs uppercase tracking-wider text-cyan-400">
                Ejercicios
            </p>

            <h2 class="mt-1 text-lg font-extrabold text-white">
                Seguimiento
            </h2>

        </div>

        <a asp-controller="Ejercicios"
           asp-action="Index"
           asp-route-citaId="@Model.CitaId"
           class="inline-flex items-center justify-center rounded-lg bg-cyan-400 px-3 py-2 text-xs font-extrabold text-[#071017] hover:bg-cyan-300 transition">

            ASIGNAR

        </a>

    </div>

    @if (!Model.Ejercicios.Any())
    {
        <div class="mt-4 rounded-xl border border-dashed border-gray-700 bg-[#0d1117] p-5 text-center">

            <p class="text-sm font-bold text-gray-300">
                No hay ejercicios asignados
            </p>

            <p class="mt-1 text-xs text-gray-500">
                Puedes asignar ejercicios personalizados desde el catálogo.
            </p>

        </div>
    }
    else
    {
        <div class="mt-4 space-y-3">

            @foreach (var ejercicio in Model.Ejercicios)
            {
                <div class="rounded-xl border @(ejercicio.Completado
                    ? "border-emerald-400/30 bg-emerald-400/5"
                    : "border-gray-800 bg-[#0d1117]") overflow-hidden">

                    @if (!string.IsNullOrWhiteSpace(
                        ejercicio.ImagenUrl))
                    {
                        <img src="@ejercicio.ImagenUrl"
                             alt="@ejercicio.Nombre"
                             class="h-32 w-full object-cover"
                             loading="lazy" />
                    }

                    <div class="p-4">

                        <div class="flex items-start justify-between gap-2">

                            <h3 class="font-bold text-white">
                                @ejercicio.Nombre
                            </h3>

                            @if (ejercicio.Completado)
                            {
                                <span class="shrink-0 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-2 py-1 text-[10px] font-bold text-emerald-300">
                                    COMPLETADO
                                </span>
                            }
                            else
                            {
                                <span class="shrink-0 rounded-full border border-amber-400/30 bg-amber-400/10 px-2 py-1 text-[10px] font-bold text-amber-300">
                                    PENDIENTE
                                </span>
                            }

                        </div>

                        <p class="mt-2 text-sm text-gray-400">
                            @ejercicio.Series series ×
                            @ejercicio.Repeticiones repeticiones
                        </p>

                        <div class="mt-3 flex flex-wrap gap-1.5">

                            <span class="tag-small">
                                @ejercicio.TipoContraccion
                            </span>

                            <span class="tag-small">
                                @ejercicio.RegionAnatomica
                            </span>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(
                            ejercicio.Instrucciones))
                        {
                            <p class="mt-3 text-xs leading-5 text-gray-500">
                                @ejercicio.Instrucciones
                            </p>
                        }

                        @if (!string.IsNullOrWhiteSpace(
                            ejercicio.VideoUrl))
                        {
                            <a href="@ejercicio.VideoUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="mt-3 inline-block text-xs font-bold text-cyan-400 hover:text-cyan-300">

                                Ver ejercicio en YouTube →

                            </a>
                        }

                        @if (ejercicio.Completado &&
                            ejercicio.FechaCompletado.HasValue)
                        {
                            <p class="mt-3 text-[11px] text-emerald-400">
                                Completado:
                                @ejercicio.FechaCompletado.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </p>
                        }

                    </div>

                </div>
            }

        </div>
    }

</div>

<style>

    .tag-small {
        border-radius: 999px;
        border: 1px solid rgba(34, 211, 238, .15);
        background: rgba(34, 211, 238, .04);
        color: #67e8f9;
        padding: .2rem .4rem;
        font-size: .58rem;
        font-weight: 700;
    }

</style>
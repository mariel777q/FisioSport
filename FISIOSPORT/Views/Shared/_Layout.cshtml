<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FisioSport</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
            body { font-family: 'Inter', sans-serif; background-color: #0d1117; }
    </style>
</head>
<body class="min-h-screen text-gray-100">
    <nav class="flex items-center justify-between px-6 py-4 border-b border-gray-800 bg-[#0d1117]/90 backdrop-blur sticky top-0 z-20">
        <span class="text-xl font-extrabold tracking-tight">
            FISIO<span class="text-cyan-400">SPORT</span>
        </span>
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a asp-controller="Account" asp-action="Logout" class="text-sm text-gray-400 hover:text-cyan-400 transition">Cerrar sesión</a>
        }
    </nav>
    <main class="max-w-6xl mx-auto px-6 py-8">
        @RenderBody()
    </main>
</body>
</html>
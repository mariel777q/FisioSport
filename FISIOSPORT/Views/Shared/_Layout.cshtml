<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - FisioSport</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <style>
            * {
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: #0d1117;
                color: #f1f5f9;
                margin: 0;
            }

            /* =========================
                       NAVBAR
                       ========================= */

            .fisio-navbar {
                position: sticky;
                top: 0;
                z-index: 1000;
                width: 100%;
                height: 72px;
                background: rgba(13, 17, 23, 0.94);
                backdrop-filter: blur(14px);
                -webkit-backdrop-filter: blur(14px);
                border-bottom: 1px solid rgba(255, 255, 255, 0.07);
                box-shadow: 0 4px 25px rgba(0, 0, 0, 0.25);
            }

            .navbar-inner {
                max-width: 1200px;
                height: 100%;
                margin: 0 auto;
                padding: 0 24px;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            /* LOGO */

            .fisio-logo {
                display: flex;
                align-items: center;
                gap: 11px;
                color: white;
                text-decoration: none;
                transition: transform 0.2s ease;
            }

                .fisio-logo:hover {
                    transform: translateY(-1px);
                }

            .logo-icon {
                width: 42px;
                height: 42px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 12px;
                background: linear-gradient( 135deg, #06b6d4, #0891b2 );
                color: white;
                font-size: 21px;
                box-shadow: 0 5px 18px rgba(6, 182, 212, 0.25);
            }

            .logo-text {
                display: flex;
                flex-direction: column;
                line-height: 1;
            }

            .logo-title {
                font-size: 19px;
                font-weight: 800;
                letter-spacing: 0.4px;
            }

            .logo-subtitle {
                margin-top: 5px;
                color: #64748b;
                font-size: 9px;
                font-weight: 600;
                letter-spacing: 2px;
                text-transform: uppercase;
            }

            /* MENU */

            .navbar-menu {
                display: flex;
                align-items: center;
                gap: 4px;
            }

            .navbar-link {
                display: flex;
                align-items: center;
                gap: 7px;
                padding: 9px 13px;
                border-radius: 8px;
                color: #94a3b8;
                text-decoration: none;
                font-size: 13px;
                font-weight: 500;
                transition: color 0.2s ease, background 0.2s ease, transform 0.2s ease;
            }

                .navbar-link:hover {
                    color: #22d3ee;
                    background: rgba(255, 255, 255, 0.05);
                    transform: translateY(-1px);
                }

                .navbar-link i {
                    font-size: 14px;
                }

            /* BOTÓN LOGIN */

            .login-button {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-left: 14px;
                padding: 10px 17px;
                border-radius: 9px;
                background: linear-gradient( 135deg, #06b6d4, #0891b2 );
                color: white;
                text-decoration: none;
                font-size: 13px;
                font-weight: 600;
                box-shadow: 0 5px 18px rgba(6, 182, 212, 0.20);
                transition: transform 0.2s ease, box-shadow 0.2s ease;
            }

                .login-button:hover {
                    color: white;
                    transform: translateY(-2px);
                    box-shadow: 0 8px 24px rgba(6, 182, 212, 0.30);
                }

                .login-button i {
                    font-size: 15px;
                }

            /* CONTENIDO */

            .main-content {
                max-width: 1200px;
                margin: 0 auto;
                padding: 32px 24px;
            }

            /* FOOTER */

            .fisio-footer {
                margin-top: 60px;
                padding: 38px 24px 24px;
                background: #090d12;
                border-top: 1px solid rgba(255, 255, 255, 0.06);
            }

            .footer-inner {
                max-width: 1200px;
                margin: 0 auto;
            }

            .footer-top {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 30px;
            }

            .footer-brand {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .footer-brand-icon {
                color: #22d3ee;
                font-size: 21px;
            }

            .footer-brand-name {
                font-size: 17px;
                font-weight: 700;
            }

            .footer-description {
                margin-top: 7px;
                color: #64748b;
                font-size: 13px;
            }

            .footer-links {
                display: flex;
                gap: 22px;
            }

                .footer-links a {
                    color: #94a3b8;
                    text-decoration: none;
                    font-size: 13px;
                    transition: color 0.2s ease;
                }

                    .footer-links a:hover {
                        color: #22d3ee;
                    }

            .footer-line {
                height: 1px;
                margin: 28px 0 18px;
                background: rgba(255, 255, 255, 0.07);
                border: 0;
            }

            .footer-copy {
                margin: 0;
                color: #475569;
                text-align: center;
                font-size: 12px;
            }

            /* =========================
                       RESPONSIVE
                       ========================= */

            @@media (max-width: 900px) {

                .navbar-menu {
                    gap: 0;
                }

                .navbar-link {
                    padding: 9px 8px;
                    font-size: 12px;
                }

                .login-button {
                    margin-left: 8px;
                    padding: 9px 12px;
                }
            }

            @@media (max-width: 700px) {

                .fisio-navbar {
                    height: auto;
                }

                .navbar-inner {
                    padding: 14px 18px;
                    flex-direction: column;
                    gap: 14px;
                }

                .navbar-menu {
                    width: 100%;
                    justify-content: center;
                    flex-wrap: wrap;
                }

                .login-button {
                    margin-left: 4px;
                }

                .main-content {
                    padding: 24px 18px;
                }

                .footer-top {
                    flex-direction: column;
                    align-items: flex-start;
                }

                .footer-links {
                    flex-wrap: wrap;
                    gap: 15px;
                }
            }
    </style>
    <link rel="manifest" href="~/manifest.json" />

    <meta name="theme-color" content="#0d1117" />

    <meta name="mobile-web-app-capable" content="yes" />

    <meta name="apple-mobile-web-app-capable" content="yes" />

    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <meta name="apple-mobile-web-app-title" content="FisioSport" />
</head>

<body>

    <!-- =========================
         NAVBAR
         ========================= -->

    <nav class="fisio-navbar">

        <div class="navbar-inner">

            <!-- LOGO -->

            <a asp-controller="Home"
               asp-action="Index"
               class="fisio-logo">

                <div class="logo-icon">
                    <i class="bi bi-heart-pulse-fill"></i>
                </div>

                <div class="logo-text">

                    <span class="logo-title">
                        FisioSport
                    </span>

                    <span class="logo-subtitle">
                        Fisioterapia
                    </span>

                </div>

            </a>


            <!-- MENÚ -->

            <div class="navbar-menu">

                <a href="/#nosotros"
                   class="navbar-link">

                    <i class="bi bi-info-circle"></i>
                    Nosotros

                </a>


                <a href="/#servicios"
                   class="navbar-link">

                    <i class="bi bi-activity"></i>
                    Servicios

                </a>


                <a href="/#instalaciones"
                   class="navbar-link">

                    <i class="bi bi-building"></i>
                    Instalaciones

                </a>


                <a href="/#especialistas"
                   class="navbar-link">

                    <i class="bi bi-people"></i>
                    Especialistas

                </a>


                <a href="/#contacto"
                   class="navbar-link">

                    <i class="bi bi-geo-alt"></i>
                    Ubicación

                </a>


                <!-- LOGIN -->

                <a asp-controller="Account"
                   asp-action="Login"
                   class="login-button">

                    <i class="bi bi-box-arrow-in-right"></i>

                    Iniciar sesión

                </a>

            </div>

        </div>

    </nav>


    <!-- =========================
         CONTENIDO
         ========================= -->

    <main class="main-content">

        @RenderBody()

    </main>


    <!-- =========================
         FOOTER
         ========================= -->

    <footer class="fisio-footer">

        <div class="footer-inner">

            <div class="footer-top">

                <div>

                    <div class="footer-brand">

                        <i class="bi bi-heart-pulse-fill footer-brand-icon"></i>

                        <span class="footer-brand-name">
                            FisioSport
                        </span>

                    </div>

                    <p class="footer-description">
                        Centro de fisioterapia y rehabilitación integral.
                    </p>

                </div>


                <div class="footer-links">

                    <a href="/#nosotros">
                        Nosotros
                    </a>

                    <a href="/#servicios">
                        Servicios
                    </a>

                    <a href="/#contacto">
                        Contacto
                    </a>

                    <a asp-controller="Account"
                       asp-action="Login">
                        Iniciar sesión
                    </a>

                </div>

            </div>


            <hr class="footer-line" />


            <p class="footer-copy">
                © @DateTime.Now.Year FisioSport.
                Todos los derechos reservados.
            </p>

        </div>

    </footer>


    @await RenderSectionAsync("Scripts", required: false)

    <script src="~/js/fisiosport-speech.js?v=1000"></script>

    <script src="~/js/fisiosport-pwa.js?v=1"></script>

</body>
</html>
